<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminQuestionsController"
            stylesheets="@../../css/theme.css, @../css/admin-dashboard.css"
            styleClass="admin-panel-bg">

    <center>
        <ScrollPane fx:id="pageScrollPane"
                    fitToWidth="true"
                    pannable="true"
                    hbarPolicy="NEVER"
                    styleClass="content-scroll">
            <content>
                <VBox spacing="16">
                    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Question Moderation" styleClass="section-title"/>
                            <Label text="Review, lock, and manage all questions" styleClass="section-subtitle"/>
                        </VBox>
                        <Button text="↻ Refresh" styleClass="secondary-btn" onAction="#handleRefresh"/>
                    </HBox>

                    <!-- Question Bank Form -->
                    <VBox styleClass="panel-card" spacing="12">
                        <Label text="Create / Edit Question Bank Entry" styleClass="panel-title"/>
                        <GridPane hgap="12" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="100"/><ColumnConstraints hgrow="ALWAYS"/>
                                <ColumnConstraints minWidth="100"/><ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Title *" styleClass="input-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="bankTitleField" styleClass="input-field" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                            <Label text="Question *" styleClass="input-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextArea fx:id="bankQuestionArea" styleClass="text-area" prefHeight="70" wrapText="true"
                                      GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                            <Label text="Department" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="bankDeptCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Semester" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                            <ComboBox fx:id="bankSemCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
                            <Label text="Subject" styleClass="input-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="bankSubjectCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Label text="Difficulty" styleClass="input-label" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                            <ComboBox fx:id="bankDifficultyCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
                            <Label text="Type" styleClass="input-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="bankTypeCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            <Label text="Status" styleClass="input-label" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                            <ComboBox fx:id="bankStatusCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="3"/>
                            <Label text="Attachment" styleClass="input-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <HBox spacing="8" GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="3">
                                <TextField fx:id="bankAttachmentField" editable="false" styleClass="input-field" HBox.hgrow="ALWAYS"/>
                                <Button text="Browse…" styleClass="secondary-btn" onAction="#handleSelectBankAttachment"/>
                            </HBox>
                        </GridPane>
                        <HBox spacing="10">
                            <Button text="💾 Save" styleClass="primary-btn" onAction="#handleSaveBankQuestion"/>
                            <Button text="✏ Update" styleClass="warning-btn" onAction="#handleUpdateBankQuestion"/>
                            <Button text="📢 Publish" styleClass="success-btn" onAction="#handlePublishBankQuestion"/>
                            <Button text="📴 Unpublish" styleClass="warning-btn" onAction="#handleUnpublishBankQuestion"/>
                            <Button text="🗑 Delete" styleClass="danger-btn" onAction="#handleDeleteBankQuestion"/>
                            <Button text="↺ Reset" styleClass="secondary-btn" onAction="#handleResetBankForm"/>
                        </HBox>
                    </VBox>

                    <!-- Filter Bar -->
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
                        <TextField fx:id="searchField" promptText="🔍  Search question or author…"
                                   styleClass="search-field" prefWidth="220" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="departmentFilter" promptText="Department" styleClass="combo-box" prefWidth="150" maxWidth="180"/>
                        <ComboBox fx:id="semesterFilter" promptText="Semester" styleClass="combo-box" prefWidth="130" maxWidth="160"/>
                        <ComboBox fx:id="subjectFilter" promptText="Subject" styleClass="combo-box" prefWidth="140" maxWidth="170"/>
                        <ComboBox fx:id="statusFilter" promptText="Status" styleClass="combo-box" prefWidth="110" maxWidth="140"/>
                        <Button text="Filter" styleClass="primary-btn" onAction="#applyFilters"/>
                        <Button text="Clear"  styleClass="secondary-btn" onAction="#clearFilters"/>
                    </HBox>

                    <!-- Questions table -->
                    <VBox styleClass="panel-card" spacing="12">
                        <Label text="All Questions" styleClass="panel-title"/>
                        <TableView fx:id="questionsTable" prefHeight="280" minHeight="180" maxHeight="280" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colQuestion" text="Question"     prefWidth="300" minWidth="150"/>
                                <TableColumn fx:id="colSubject"  text="Subject"      prefWidth="130" minWidth="80"/>
                                <TableColumn fx:id="colAuthor"   text="Author"       prefWidth="130" minWidth="80"/>
                                <TableColumn fx:id="colVotes"    text="👍 Votes"     prefWidth="75"  minWidth="50"/>
                                <TableColumn fx:id="colAnswers"  text="💬 Answers"   prefWidth="80"  minWidth="55"/>
                                <TableColumn fx:id="colViews"    text="👁 Views"     prefWidth="75"  minWidth="50"/>
                                <TableColumn fx:id="colDate"     text="Date"         prefWidth="130" minWidth="80"/>
                                <TableColumn fx:id="colStatus"   text="Status"       prefWidth="90"  minWidth="65"/>
                                <TableColumn fx:id="colActions"  text="Actions"      prefWidth="220" minWidth="150"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                            </columnResizePolicy>
                            <placeholder><Label text="No questions found." styleClass="table-empty-label"/></placeholder>
                        </TableView>

                        <!-- Pagination -->
                        <HBox alignment="CENTER" spacing="14">
                            <Button fx:id="btnPrevPage" text="◀ Prev" styleClass="secondary-btn" onAction="#handlePrevPage"/>
                            <Label fx:id="lblPageNumber" text="Page 1 of 1"
                                   styleClass="detail-section-title"/>
                            <Button fx:id="btnNextPage" text="Next ▶" styleClass="secondary-btn" onAction="#handleNextPage"/>
                        </HBox>

                        <!-- Question actions -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="🔒 Lock"             styleClass="warning-btn"  onAction="#handleLock"/>
                            <Button text="🔓 Unlock"           styleClass="success-btn"  onAction="#handleUnlock"/>
                            <Button text="🗑 Delete Question"   styleClass="danger-btn"   onAction="#handleDeleteQuestion"/>
                        </HBox>
                    </VBox>

                    <!-- Question detail + Answers -->
                    <GridPane hgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="40"/>
                            <ColumnConstraints percentWidth="60"/>
                        </columnConstraints>

                        <VBox styleClass="panel-card" spacing="10" GridPane.columnIndex="0">
                            <Label text="Question Details" styleClass="panel-title"/>
                            <TextArea fx:id="questionDetailArea"
                                      editable="false"
                                      wrapText="true"
                                      prefHeight="180"
                                      minHeight="120"
                                      maxHeight="180"
                                      styleClass="hint-text"/>
                        </VBox>

                        <VBox styleClass="panel-card" spacing="10" GridPane.columnIndex="1">
                            <Label text="Answers for Selected Question" styleClass="panel-title"/>
                            <TableView fx:id="answersTable" prefHeight="180" minHeight="120" maxHeight="180" styleClass="table-view">
                                <columns>
                                    <TableColumn fx:id="colAnswerAuthor" text="Author" prefWidth="130" minWidth="80"/>
                                    <TableColumn fx:id="colAnswerText"   text="Answer" prefWidth="260" minWidth="120"/>
                                    <TableColumn fx:id="colAnswerVotes"  text="Votes"  prefWidth="70"  minWidth="50"/>
                                    <TableColumn fx:id="colAnswerDate"   text="Date"   prefWidth="130" minWidth="80"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                                </columnResizePolicy>
                                <placeholder><Label text="Select a question to see answers." styleClass="table-empty-label"/></placeholder>
                            </TableView>
                            <Button text="🗑 Delete Selected Answer" styleClass="danger-btn" onAction="#handleDeleteAnswer"/>
                        </VBox>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
