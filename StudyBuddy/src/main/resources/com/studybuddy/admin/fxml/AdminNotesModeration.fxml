<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="content-scroll"
            stylesheets="@../../css/theme.css, @../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminNotesController">
    <content>
        <VBox spacing="16" styleClass="admin-panel-bg">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Notes Management" styleClass="section-title"/>
                    <Label fx:id="lblTotalCount" text="Loading…" styleClass="section-subtitle"/>
                </VBox>
                <Button text="↻ Refresh" styleClass="secondary-btn" onAction="#handleRefresh"/>
            </HBox>

            <!-- Stats -->
            <HBox spacing="14">
                <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Total Notes" styleClass="stat-label"/>
                    <Label fx:id="lblStatTotal" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Pending" styleClass="stat-label"/>
                    <Label fx:id="lblStatPending" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Approved" styleClass="stat-label"/>
                    <Label fx:id="lblStatApproved" text="0" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <!-- Upload Form -->
            <VBox styleClass="panel-card" spacing="12">
                <Label text="Upload / Edit Note" styleClass="panel-title"/>
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Title *" styleClass="input-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="uploadTitleField" styleClass="input-field" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

                    <Label text="Description" styleClass="input-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextArea fx:id="uploadDescriptionField" styleClass="text-area" prefHeight="60" wrapText="true"
                              GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

                    <Label text="Department *" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="uploadDepartmentCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Semester *" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="uploadSemesterCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                    <Label text="Subject *" styleClass="input-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="uploadSubjectCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Tags" styleClass="input-label" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                    <TextField fx:id="uploadTagsField" promptText="comma-separated" styleClass="input-field" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

                    <Label text="File" styleClass="input-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="2">
                        <TextField fx:id="uploadFileField" editable="false" styleClass="input-field" HBox.hgrow="ALWAYS"/>
                        <Button text="Browse…" styleClass="secondary-btn" onAction="#handleSelectFile"/>
                    </HBox>
                    <HBox spacing="8" GridPane.rowIndex="4" GridPane.columnIndex="3">
                        <ComboBox fx:id="uploadVisibilityCombo" promptText="Visibility" styleClass="combo-box" prefWidth="100"/>
                        <ComboBox fx:id="uploadStatusCombo" promptText="Status" styleClass="combo-box" prefWidth="100"/>
                    </HBox>
                </GridPane>
                <HBox spacing="10">
                    <Button text="📤 Upload" styleClass="primary-btn" onAction="#handleUpload"/>
                    <Button text="✏ Update" styleClass="warning-btn" onAction="#handleUpdate"/>
                    <Button text="↺ Reset" styleClass="secondary-btn" onAction="#handleResetForm"/>
                </HBox>
            </VBox>

            <!-- Filters -->
            <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT" styleClass="filter-bar">
                <TextField fx:id="searchField" promptText="🔍 Search…" styleClass="search-field" prefWidth="200"/>
                <ComboBox fx:id="departmentFilter" promptText="Department" styleClass="combo-box" prefWidth="130"/>
                <ComboBox fx:id="semesterFilter" promptText="Semester" styleClass="combo-box" prefWidth="110"/>
                <ComboBox fx:id="subjectFilter" promptText="Subject" styleClass="combo-box" prefWidth="120"/>
                <ComboBox fx:id="statusFilter" promptText="Status" styleClass="combo-box" prefWidth="100"/>
                <ComboBox fx:id="visibilityFilter" promptText="Visibility" styleClass="combo-box" prefWidth="100"/>
                <Button text="Filter" styleClass="primary-btn" onAction="#applyFilters"/>
                <Button text="Clear" styleClass="secondary-btn" onAction="#clearFilters"/>
            </FlowPane>

            <!-- Table -->
            <TableView fx:id="notesTable" prefHeight="320" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colFileName" text="File Name" prefWidth="130"/>
                    <TableColumn fx:id="colTitle" text="Title" prefWidth="160"/>
                    <TableColumn fx:id="colSubject" text="Subject" prefWidth="110"/>
                    <TableColumn fx:id="colDepartment" text="Department" prefWidth="100"/>
                    <TableColumn fx:id="colSemester" text="Semester" prefWidth="80"/>
                    <TableColumn fx:id="colUploader" text="Uploaded By" prefWidth="110"/>
                    <TableColumn fx:id="colDate" text="Upload Date" prefWidth="120"/>
                    <TableColumn fx:id="colDownloads" text="Downloads" prefWidth="80"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="80"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder><Label text="No notes found." styleClass="table-empty-label"/></placeholder>
            </TableView>

            <!-- Pagination -->
            <HBox alignment="CENTER" spacing="14">
                <Button fx:id="btnPrevPage" text="◀ Prev" styleClass="secondary-btn" onAction="#handlePrevPage"/>
                <Label fx:id="lblPageNumber" text="Page 1 of 1" styleClass="page-info-label"/>
                <Button fx:id="btnNextPage" text="Next ▶" styleClass="secondary-btn" onAction="#handleNextPage"/>
            </HBox>

            <!-- Actions -->
            <VBox styleClass="panel-card" spacing="10">
                <Label text="Row Actions" styleClass="panel-title"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button text="👁 View" styleClass="secondary-btn" onAction="#handleView"/>
                    <Button text="⬇ Download" styleClass="primary-btn" onAction="#handleDownload"/>
                    <Button text="✏ Edit" styleClass="warning-btn" onAction="#handleEdit"/>
                    <Button text="✅ Approve" styleClass="success-btn" onAction="#handleApprove"/>
                    <Button text="❌ Reject" styleClass="danger-btn" onAction="#handleReject"/>
                    <Button text="🙈 Hide" styleClass="secondary-btn" onAction="#handleHide"/>
                    <Button text="🗑 Delete" styleClass="danger-btn" onAction="#handleDelete"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
