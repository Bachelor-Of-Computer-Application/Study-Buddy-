<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="content-scroll"
            stylesheets="@../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminReportsController">
    <content>
        <VBox spacing="18" style="-fx-background-color: #f1f5f9;">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Reports &amp; Analytics" styleClass="section-title"/>
                    <Label text="Data-driven insights from your platform" styleClass="section-subtitle"/>
                </VBox>
                <Button text="↻ Refresh" styleClass="secondary-btn" onAction="#handleRefresh"/>
            </HBox>

            <!-- ── Row 1: Monthly Uploads + Registrations ── -->
            <GridPane hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox styleClass="panel-card" spacing="12" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Monthly Note Uploads" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                        <Button text="Export CSV" styleClass="secondary-btn"
                                style="-fx-font-size:11px; -fx-padding:5 10;"
                                onAction="#handleExportUploads"/>
                    </HBox>
                    <BarChart fx:id="uploadsChart" prefHeight="220" animated="false" legendVisible="false">
                        <xAxis><CategoryAxis fx:id="uploadsX"/></xAxis>
                        <yAxis><NumberAxis fx:id="uploadsY"/></yAxis>
                    </BarChart>
                </VBox>

                <VBox styleClass="panel-card" spacing="12" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Monthly Registrations" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                        <Button text="Export CSV" styleClass="secondary-btn"
                                style="-fx-font-size:11px; -fx-padding:5 10;"
                                onAction="#handleExportRegistrations"/>
                    </HBox>
                    <LineChart fx:id="registrationsChart" prefHeight="220" animated="false" legendVisible="false">
                        <xAxis><CategoryAxis fx:id="registrationsX"/></xAxis>
                        <yAxis><NumberAxis fx:id="registrationsY"/></yAxis>
                    </LineChart>
                </VBox>
            </GridPane>

            <!-- ── Row 2: Subject Pie + Top Resources Chart ── -->
            <GridPane hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="40"/>
                    <ColumnConstraints percentWidth="60"/>
                </columnConstraints>

                <VBox styleClass="panel-card" spacing="12" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Notes by Subject" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                        <Button text="Export CSV" styleClass="secondary-btn"
                                style="-fx-font-size:11px; -fx-padding:5 10;"
                                onAction="#handleExportSubjects"/>
                    </HBox>
                    <PieChart fx:id="subjectPieChart" prefHeight="240" legendVisible="true" labelsVisible="true"/>
                </VBox>

                <VBox styleClass="panel-card" spacing="12" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Top Downloaded Resources" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                        <Button text="Export CSV" styleClass="secondary-btn"
                                style="-fx-font-size:11px; -fx-padding:5 10;"
                                onAction="#handleExportTopResources"/>
                    </HBox>
                    <BarChart fx:id="topResourcesChart" prefHeight="240" animated="false" legendVisible="false">
                        <xAxis><CategoryAxis fx:id="topResourcesX" style="-fx-tick-label-rotate: -35;"/></xAxis>
                        <yAxis><NumberAxis fx:id="topResourcesY"/></yAxis>
                    </BarChart>
                </VBox>
            </GridPane>

            <!-- ── Row 3: Top Active Users + Top Resources (tables) ── -->
            <GridPane hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox styleClass="panel-card" spacing="12" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Most Active Users" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                        <Button text="Export CSV" styleClass="secondary-btn"
                                style="-fx-font-size:11px; -fx-padding:5 10;"
                                onAction="#handleExportTopUsers"/>
                    </HBox>
                    <TableView fx:id="topUsersTable" prefHeight="220" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colUserName"  text="User Name"      prefWidth="200"/>
                            <TableColumn fx:id="colUserScore" text="Activity Score"  prefWidth="140"/>
                        </columns>
                        <placeholder><Label text="No data." style="-fx-text-fill:#94a3b8;"/></placeholder>
                    </TableView>
                </VBox>

                <VBox styleClass="panel-card" spacing="12" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Top Downloaded Resources" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <TableView fx:id="topResourcesTable" prefHeight="220" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colResTitle"     text="Resource Title" prefWidth="240"/>
                            <TableColumn fx:id="colResDownloads" text="Downloads"      prefWidth="110"/>
                        </columns>
                        <placeholder><Label text="No data." style="-fx-text-fill:#94a3b8;"/></placeholder>
                    </TableView>
                </VBox>
            </GridPane>

        </VBox>
    </content>
</ScrollPane>
