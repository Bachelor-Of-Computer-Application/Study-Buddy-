<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" pannable="true" stylesheets="@../../css/theme.css, @../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminNotificationsController">
    <content>
        <VBox spacing="16" styleClass="admin-panel-bg">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Notification Management" styleClass="section-title"/>
                    <Label fx:id="lblUnreadCount" text="Unread: 0" styleClass="section-subtitle"/>
                </VBox>
                <Button text="↻ Refresh" styleClass="secondary-btn" onAction="#handleRefresh"/>
            </HBox>

            <GridPane hgap="16" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="45"/>
                    <ColumnConstraints percentWidth="55"/>
                </columnConstraints>

                <VBox styleClass="panel-card" spacing="12" GridPane.columnIndex="0">
                    <Label text="Send Notification" styleClass="panel-title"/>
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120"/><ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Title *" styleClass="input-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="titleField" styleClass="input-field" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Message *" styleClass="input-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextArea fx:id="messageArea" styleClass="text-area" prefHeight="80" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Type" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="notificationTypeCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Priority" styleClass="input-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="priorityCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Recipients" styleClass="input-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="recipientTypeCombo" onAction="#onRecipientTypeChanged" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        <Label fx:id="recipientValueLabel" text="Target" styleClass="input-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="recipientValueField" styleClass="input-field" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        <Label text="Department" styleClass="input-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="deptCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                        <Label text="Semester" styleClass="input-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="semCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                        <Label text="Expiry Date" styleClass="input-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="expiryDatePicker" styleClass="input-field" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                        <Label text="Attachment" styleClass="input-label" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                        <HBox spacing="8" GridPane.rowIndex="9" GridPane.columnIndex="1">
                            <TextField fx:id="attachmentField" editable="false" styleClass="input-field" HBox.hgrow="ALWAYS"/>
                            <Button text="Browse…" styleClass="secondary-btn" onAction="#handleSelectAttachment"/>
                        </HBox>
                    </GridPane>
                    <HBox spacing="10">
                        <Button text="📤 Send" styleClass="primary-btn" onAction="#handleSend"/>
                        <Button text="✖ Clear" styleClass="secondary-btn" onAction="#handleClearForm"/>
                    </HBox>
                </VBox>

                <VBox styleClass="panel-card" spacing="12" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Notification History" styleClass="panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="historySearchField" promptText="Search…" styleClass="search-field" prefWidth="140"/>
                        <ComboBox fx:id="historyTypeFilter" promptText="Type" styleClass="combo-box" prefWidth="110"/>
                    </HBox>
                    <TableView fx:id="historyTable" prefHeight="400" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colTitle" text="Title" prefWidth="140"/>
                            <TableColumn fx:id="colRecipient" text="Recipient" prefWidth="120"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="90"/>
                            <TableColumn fx:id="colPriority" text="Priority" prefWidth="80"/>
                            <TableColumn fx:id="colSentAt" text="Sent At" prefWidth="120"/>
                            <TableColumn fx:id="colRead" text="Status" prefWidth="80"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                        </columnResizePolicy>
                    </TableView>
                    <HBox spacing="8">
                        <Button text="✅ Mark Read" styleClass="secondary-btn" onAction="#handleMarkRead"/>
                        <Button text="📦 Archive" styleClass="secondary-btn" onAction="#handleArchive"/>
                        <Button text="🗑 Delete" styleClass="danger-btn" onAction="#handleDelete"/>
                    </HBox>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
