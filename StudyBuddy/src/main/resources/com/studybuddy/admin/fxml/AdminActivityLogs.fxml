<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" styleClass="content-scroll"
            stylesheets="@../../css/theme.css, @../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminActivityLogsController">
    <content>
        <VBox spacing="16" styleClass="admin-panel-bg">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Activity Logs" styleClass="section-title"/>
            <Label fx:id="lblTotalCount" text="" styleClass="section-subtitle"/>
        </VBox>
        <Button text="📤 Export CSV" styleClass="secondary-btn" onAction="#handleExport"/>
        <Button text="↻ Refresh"    styleClass="secondary-btn" onAction="#handleRefresh"/>
    </HBox>

    <!-- Filter Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
        <!-- Full-text search -->
        <TextField fx:id="searchField"
                   promptText="🔍  Search admin, action, target…"
                   styleClass="search-field"
                   prefWidth="280"/>
        <Button text="Search" styleClass="primary-btn" onAction="#handleSearch"/>

        <Separator orientation="VERTICAL" styleClass="filter-separator"/>

        <!-- Date range filter -->
        <Label text="From:" styleClass="input-label"/>
        <DatePicker fx:id="fromDatePicker" promptText="Start date" prefWidth="140"/>

        <Label text="To:" styleClass="input-label"/>
        <DatePicker fx:id="toDatePicker" promptText="End date" prefWidth="140"/>

        <Button text="Filter by Date" styleClass="primary-btn"   onAction="#handleDateFilter"/>
        <Button text="Clear Filters"  styleClass="secondary-btn" onAction="#handleClearFilters"/>
    </HBox>

    <!-- Logs Table -->
    <TableView fx:id="logsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colId"         text="ID"          prefWidth="60"  minWidth="45"/>
            <TableColumn fx:id="colAdmin"      text="Admin"       prefWidth="140" minWidth="90"/>
            <TableColumn fx:id="colAction"     text="Action"      prefWidth="200" minWidth="120"/>
            <TableColumn fx:id="colTargetType" text="Target Type" prefWidth="120" minWidth="80"/>
            <TableColumn fx:id="colTargetName" text="Target"      prefWidth="200" minWidth="100"/>
            <TableColumn fx:id="colStatus"     text="Status"      prefWidth="90"  minWidth="60"/>
            <TableColumn fx:id="colTimestamp"  text="Timestamp"   prefWidth="160" minWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No activity logs found. Actions you perform are recorded here automatically."
                   styleClass="admin-logs-empty" wrapText="true"/>
        </placeholder>
    </TableView>

    <!-- Info note -->
    <Label text="ℹ  Every admin action (user edits, approvals, deletions, logins) is automatically logged here. Requires the ActivityLogs table in your database."
           wrapText="true"
           styleClass="admin-logs-hint"/>
        </VBox>
    </content>
</ScrollPane>
