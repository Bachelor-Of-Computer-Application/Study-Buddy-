<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="content-scroll"
            stylesheets="@../../css/theme.css, @../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminSettingsController">
    <content>
        <VBox spacing="20" styleClass="admin-settings-bg">
            <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>

            <Label text="System Settings" styleClass="section-title"/>
            <Label text="Configure app parameters and manage departments/semesters from the database"
                   styleClass="section-subtitle"/>

            <!-- App Settings -->
            <VBox styleClass="panel-card" spacing="14">
                <Label text="Application Settings" styleClass="panel-title"/>
                <GridPane hgap="16" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="180"/><ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Application Name" styleClass="input-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="appNameField" styleClass="input-field" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Maintenance Mode" styleClass="input-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="maintenanceModeCheck" text="Enable maintenance mode" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Max Upload (MB)" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="maxUploadSizeField" styleClass="input-field" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Allowed File Types" styleClass="input-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="allowedFileTypesField" styleClass="input-field" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Storage Directory" styleClass="input-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="storageDirectoryField" promptText="Leave empty for ~/StudyBuddy/uploads" styleClass="input-field" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label text="Default Department" styleClass="input-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="defaultDepartmentCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <Label text="Default Semester" styleClass="input-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="defaultSemesterCombo" styleClass="combo-box" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                </GridPane>
                <HBox spacing="10">
                    <Button text="💾 Save Settings" styleClass="primary-btn" onAction="#handleSave"/>
                    <Button text="↺ Reset" styleClass="secondary-btn" onAction="#handleReset"/>
                </HBox>
            </VBox>

            <!-- Department Management -->
            <VBox styleClass="panel-card" spacing="12">
                <Label text="Department Management" styleClass="panel-title"/>
                <HBox spacing="16">
                    <TableView fx:id="departmentsTable" prefHeight="180" HBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="deptNameCol" text="Name" prefWidth="140"/>
                            <TableColumn fx:id="deptCodeCol" text="Code" prefWidth="80"/>
                            <TableColumn fx:id="deptActiveCol" text="Active" prefWidth="70"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                        </columnResizePolicy>
                    </TableView>
                    <VBox spacing="8" prefWidth="280">
                        <TextField fx:id="deptNameField" promptText="Department Name" styleClass="input-field"/>
                        <TextField fx:id="deptCodeField" promptText="Code (e.g. BCA)" styleClass="input-field"/>
                        <TextArea fx:id="deptDescField" promptText="Description" styleClass="text-area" prefHeight="50"/>
                        <HBox spacing="6">
                            <Button text="Add" styleClass="primary-btn" onAction="#handleAddDepartment"/>
                            <Button text="Update" styleClass="warning-btn" onAction="#handleUpdateDepartment"/>
                            <Button text="Delete" styleClass="danger-btn" onAction="#handleDeleteDepartment"/>
                            <Button text="Toggle Active" styleClass="secondary-btn" onAction="#handleToggleDepartment"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Semester Management -->
            <VBox styleClass="panel-card" spacing="12">
                <Label text="Semester Management" styleClass="panel-title"/>
                <HBox spacing="16">
                    <TableView fx:id="semestersTable" prefHeight="180" HBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="semNameCol" text="Name" prefWidth="120"/>
                            <TableColumn fx:id="semNumberCol" text="#" prefWidth="50"/>
                            <TableColumn fx:id="semDeptCol" text="Department" prefWidth="120"/>
                            <TableColumn fx:id="semActiveCol" text="Active" prefWidth="70"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                        </columnResizePolicy>
                    </TableView>
                    <VBox spacing="8" prefWidth="280">
                        <ComboBox fx:id="semDeptCombo" promptText="Department" styleClass="combo-box" maxWidth="Infinity"/>
                        <TextField fx:id="semNameField" promptText="Semester Name" styleClass="input-field"/>
                        <TextField fx:id="semNumberField" promptText="Semester Number" styleClass="input-field"/>
                        <TextArea fx:id="semDescField" promptText="Description" styleClass="text-area" prefHeight="50"/>
                        <HBox spacing="6">
                            <Button text="Add" styleClass="primary-btn" onAction="#handleAddSemester"/>
                            <Button text="Update" styleClass="warning-btn" onAction="#handleUpdateSemester"/>
                            <Button text="Delete" styleClass="danger-btn" onAction="#handleDeleteSemester"/>
                            <Button text="Toggle Active" styleClass="secondary-btn" onAction="#handleToggleSemester"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Password -->
            <VBox styleClass="panel-card" spacing="12">
                <Label text="Change Admin Password" styleClass="panel-title"/>
                <GridPane hgap="12" vgap="10">
                    <Label text="Current" styleClass="input-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="currentPasswordField" styleClass="input-field" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="New" styleClass="input-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="newPasswordField" styleClass="input-field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Confirm" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="confirmPasswordField" styleClass="input-field" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
                <Button text="🔑 Change Password" styleClass="warning-btn" onAction="#handleChangePassword"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
