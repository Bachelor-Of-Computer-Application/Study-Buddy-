<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="content-scroll"
            stylesheets="@../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminSettingsController">
    <content>
        <VBox spacing="20" style="-fx-background-color: #f1f5f9;">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="System Settings" styleClass="section-title"/>
                    <Label text="Configure application-wide parameters (persisted to database)" styleClass="section-subtitle"/>
                </VBox>
            </HBox>

            <!-- ── Application Settings Card ── -->
            <VBox styleClass="panel-card" spacing="16">
                <Label text="Application Settings" styleClass="panel-title"/>

                <GridPane hgap="16" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints minWidth="200" prefWidth="220"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Application Name" styleClass="input-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="appNameField" promptText="StudyBuddy" styleClass="input-field"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Maintenance Mode" styleClass="input-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="maintenanceModeCheck" text="Enable maintenance mode (disables user access)"
                              GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Max Upload Size (MB)" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="maxUploadSizeField" promptText="50" styleClass="input-field"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Allowed File Types" styleClass="input-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="allowedFileTypesField" promptText="pdf,docx,pptx,xlsx,jpg,png"
                               styleClass="input-field" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Default Semester" styleClass="input-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="defaultSemesterCombo" styleClass="combo-box" prefWidth="120"
                              GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Default Department" styleClass="input-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="defaultDepartmentCombo" styleClass="combo-box" prefWidth="240"
                              GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="12">
                    <Button text="💾 Save Settings" styleClass="primary-btn" onAction="#handleSave"/>
                    <Button text="↺ Reset to Defaults" styleClass="secondary-btn" onAction="#handleReset"/>
                </HBox>
            </VBox>

            <!-- ── Password Change Card ── -->
            <VBox styleClass="panel-card" spacing="16">
                <Label text="Change Admin Password" styleClass="panel-title"/>
                <Label text="Requires current password verification. New password must be at least 6 characters."
                       styleClass="panel-subtitle" wrapText="true"/>

                <GridPane hgap="16" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints minWidth="200" prefWidth="220"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Current Password" styleClass="input-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="currentPasswordField" promptText="Enter current password"
                                  styleClass="input-field" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="New Password" styleClass="input-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="newPasswordField" promptText="At least 6 characters"
                                  styleClass="input-field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Confirm New Password" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password"
                                  styleClass="input-field" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>

                <Button text="🔑 Change Password" styleClass="warning-btn" onAction="#handleChangePassword"/>
            </VBox>

            <!-- Info note -->
            <Label text="ℹ  Settings are loaded from and saved to the Settings table in your SQL Server database. Create this table if it doesn't exist yet."
                   wrapText="true"
                   style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 0 0 20 0;"/>

        </VBox>
    </content>
</ScrollPane>
