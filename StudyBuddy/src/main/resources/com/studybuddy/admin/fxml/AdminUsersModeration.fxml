<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" styleClass="content-scroll"
            stylesheets="@../../css/theme.css, @../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminUsersController">
    <content>
        <VBox spacing="16" styleClass="admin-panel-bg">
            <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="User Management" styleClass="section-title"/>
            <Label fx:id="lblTotalCount" text="Loading…" styleClass="section-subtitle"/>
        </VBox>
        <Button text="↻ Refresh" styleClass="secondary-btn" onAction="#handleRefresh"/>
        <Button text="📤 Export CSV" styleClass="secondary-btn" onAction="#handleExport"/>
    </HBox>

    <!-- Filter Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
        <TextField fx:id="searchField" promptText="🔍  Search username, name, or email…"
                   styleClass="search-field" prefWidth="220" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="roleFilter" promptText="All Roles" styleClass="combo-box" prefWidth="120"/>
        <ComboBox fx:id="departmentFilter" promptText="All Departments" styleClass="combo-box" prefWidth="150"/>
        <ComboBox fx:id="semesterFilter" promptText="All Semesters" styleClass="combo-box" prefWidth="140"/>
        <ComboBox fx:id="statusFilter" promptText="All Statuses" styleClass="combo-box" prefWidth="120"/>
        <Button text="Filter" styleClass="primary-btn" onAction="#applyFilters"/>
        <Button text="Clear" styleClass="secondary-btn" onAction="#clearFilters"/>
    </HBox>

    <!-- Users Table -->
    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colUsername"   text="Username"   prefWidth="120" minWidth="90"/>
            <TableColumn fx:id="colFullName"   text="Full Name"  prefWidth="160" minWidth="100"/>
            <TableColumn fx:id="colEmail"      text="Email"      prefWidth="200" minWidth="140"/>
            <TableColumn fx:id="colDepartment" text="Department" prefWidth="140" minWidth="100"/>
            <TableColumn fx:id="colSemester"   text="Semester"   prefWidth="100" minWidth="70"/>
            <TableColumn fx:id="colRole"       text="Role"       prefWidth="90"  minWidth="70"/>
            <TableColumn fx:id="colStatus"     text="Status"     prefWidth="90"  minWidth="70"/>
            <TableColumn fx:id="colCreatedAt"  text="Registered" prefWidth="100" minWidth="80"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
        <placeholder><Label text="No users found." styleClass="table-empty-label" /></placeholder>
    </TableView>

    <!-- Pagination -->
    <HBox alignment="CENTER" spacing="14">
        <Button fx:id="btnPrevPage" text="◀ Prev" styleClass="secondary-btn" onAction="#handlePrevPage"/>
        <Label fx:id="lblPageNumber" text="Page 1 of 1"
               styleClass="detail-section-title"/>
        <Button fx:id="btnNextPage" text="Next ▶" styleClass="secondary-btn" onAction="#handleNextPage"/>
    </HBox>

    <!-- Action Buttons -->
    <VBox styleClass="panel-card" spacing="12">
        <Label text="Selected User Actions" styleClass="panel-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="👁 View"           styleClass="secondary-btn" onAction="#handleView"/>
            <Button text="✏️ Edit"           styleClass="primary-btn"  onAction="#handleEdit"/>
            <Button text="🔑 Reset Password" styleClass="warning-btn"  onAction="#handleResetPassword"/>
            <Button text="⏸ Suspend"         styleClass="warning-btn"  onAction="#handleSuspend"/>
            <Button text="▶ Activate"        styleClass="success-btn"  onAction="#handleActivate"/>
            <Button text="🚫 Ban"            styleClass="danger-btn"   onAction="#handleBan"/>
            <Button text="🗑 Delete"          styleClass="danger-btn"   onAction="#handleDelete"/>
        </HBox>
        </VBox>
    </content>
</ScrollPane>
