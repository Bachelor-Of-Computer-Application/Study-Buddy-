<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!-- Main dashboard shell: sidebar (left) + content (center) -->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminDashboardController"
            stylesheets="@../../css/theme.css, @../css/admin-dashboard.css"
            styleClass="root-pane">

    <!-- ══ LEFT SIDEBAR ══════════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="4"
              prefWidth="240" minWidth="240">
            <padding><Insets top="20" right="14" bottom="20" left="14"/></padding>

            <!-- Brand -->
            <VBox spacing="6" styleClass="brand-box sidebar-brand-header">
                <ImageView fitWidth="150" fitHeight="50" preserveRatio="true" smooth="true" cache="true"
                           styleClass="app-brand-logo">
                    <image>
                        <Image url="@../../images/main_logo_study_buddyy.png"/>
                    </image>
                </ImageView>
                <Label text="Admin Panel" styleClass="brand-subtitle"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Global search -->
            <TextField fx:id="globalSearchField"
                       promptText="🔍  Global search…"
                       styleClass="search-field sidebar-search-field"
                       maxWidth="Infinity">
                <VBox.margin><Insets top="6" bottom="4"/></VBox.margin>
            </TextField>

            <Separator styleClass="sidebar-separator"/>

            <!-- Navigation section -->
            <Label text="NAVIGATION" styleClass="nav-section-label"/>

            <VBox spacing="2" VBox.vgrow="ALWAYS">
                <Button fx:id="btnOverview"
                        text="📊  Overview"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showOverview"/>
                <Button fx:id="btnUsers"
                        text="👥  Users"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showUsers"/>
                <Button fx:id="btnNotes"
                        text="📝  Notes"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showNotes"/>
                <Button fx:id="btnResources"
                        text="📂  Resources"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showResources"/>
                <Button fx:id="btnQuestions"
                        text="❓  Questions"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showQuestions"/>
                <Button fx:id="btnReports"
                        text="📈  Reports"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showReports"/>
                <Button fx:id="btnNotifications"
                        text="🔔  Notifications"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showNotifications"/>
                <Button fx:id="btnActivityLogs"
                        text="📋  Activity Logs"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showActivityLogs"/>
                <Button fx:id="btnSettings"
                        text="⚙️  Settings"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showSettings"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Admin info box -->
            <HBox styleClass="admin-info-box" spacing="10" alignment="CENTER_LEFT">
                <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
                    <image>
                        <Image url="@../../images/round-account-button.png"/>
                    </image>
                </ImageView>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="adminNameLabel" text="Administrator" styleClass="admin-name-label"/>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="👤" styleClass="admin-role-icon"/>
                        <Label fx:id="adminRoleLabel" text="ADMIN" styleClass="admin-role-label"/>
                    </HBox>
                </VBox>
            </HBox>

            <Button text="🚪  Logout"
                    styleClass="logout-btn"
                    maxWidth="Infinity"
                    onAction="#handleLogout">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- ══ DYNAMIC CONTENT AREA ══════════════════════════════════════ -->
    <center>
        <StackPane fx:id="adminContentArea" styleClass="admin-content-area"/>
    </center>

</BorderPane>
