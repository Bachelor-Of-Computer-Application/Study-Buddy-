<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminDashboardController"
            stylesheets="@../css/admin-dashboard.css"
            styleClass="root-pane"
            prefHeight="760.0" prefWidth="1280.0">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="260" styleClass="sidebar" spacing="12">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="brand-box">
                <Label text="Study Buddy" styleClass="brand-title"/>
            </HBox>

            <Separator styleClass="sidebar-separator" />

            <VBox spacing="6" styleClass="nav-section" VBox.vgrow="ALWAYS">
                <Label text="NAVIGATION" styleClass="nav-section-title"/>
                <Button text="📊 Dashboard" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showOverview"/>
                <Button text="👥 Users" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showUsers"/>
                <Button text="📝 Notes" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showNotes"/>
                <Button text="📂 Resources" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showResources"/>
                <Button text="🙋 Questions" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showQuestions"/>
                <Button text="📈 Reports" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showReports"/>
                <Button text="⚙️ Settings" styleClass="nav-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#showSettings"/>
            </VBox>

            <Button text="🚪 Logout" styleClass="logout-btn" maxWidth="Infinity" alignment="BASELINE_LEFT" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- CENTER DYNAMIC CONTENT AREA -->
    <center>
        <StackPane fx:id="adminContentArea" styleClass="admin-content-area" />
    </center>

</BorderPane>
