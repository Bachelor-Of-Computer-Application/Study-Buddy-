<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="root-pane" stylesheets="@../css/theme.css, @../css/achievements.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.studybuddy.controllers.AchievementsController">

    <!-- ═══ HEADER ══════════════════════════════════════════════════════ -->
    <top>
        <VBox spacing="12" styleClass="header-container">
            <padding><Insets top="24" right="24" bottom="16" left="24" /></padding>
            
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="🏆 Achievements" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshBtn" onAction="#refreshAchievements" styleClass="secondary-btn" text="🔄 Refresh"/>
                <Button onAction="#handleGoToProfile" styleClass="primary-btn" text="👤 Profile"/>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="4">
                    <Label fx:id="totalAchievementsLabel" styleClass="stat-value" text="0"/>
                    <Label styleClass="stat-label" text="Total Achievements"/>
                </VBox>
                <VBox spacing="4">
                    <Label fx:id="unlockedAchievementsLabel" styleClass="stat-value, stat-value-success" text="0"/>
                    <Label styleClass="stat-label" text="Unlocked"/>
                </VBox>
                <VBox spacing="4">
                    <Label fx:id="totalRewardPointsLabel" styleClass="stat-value, stat-value-purple" text="0"/>
                    <Label styleClass="stat-label" text="Reward Points Earned"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- ═══ CONTENT ══════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <VBox spacing="20" styleClass="main-content">
                <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>

                <!-- Unlocked Achievements Section -->
                <VBox spacing="12">
                    <Label text="✨ Unlocked Achievements" styleClass="section-title"/>
                    <FlowPane fx:id="unlockedAchievementsContainer" hgap="16" vgap="16" styleClass="achievements-flow"/>
                </VBox>

                <!-- Locked Achievements Section -->
                <VBox spacing="12">
                    <Label text="🔒 Locked Achievements" styleClass="section-title"/>
                    <FlowPane fx:id="lockedAchievementsContainer" hgap="16" vgap="16" styleClass="achievements-flow"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
