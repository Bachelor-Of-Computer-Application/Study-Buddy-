<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainBorderPane" styleClass="root-pane"
    stylesheets="@../css/theme.css, @../css/notes.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.studybuddy.controllers.NotesController">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="scroll-pane" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="18">
                    <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>

                    <!-- ── Page Header Card ──────────────────────────── -->
                    <HBox alignment="CENTER_LEFT" spacing="20"
                          styleClass="page-header-card">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="📝  My Notes" styleClass="page-title"/>
                            <Label styleClass="page-subtitle"
                                   text="Create personal notebooks, study guides, and share with the community."/>
                        </VBox>
                        <Button onAction="#showCreateNoteDialog"
                                styleClass="create-note-btn"
                                text="＋  Create Note"/>
                    </HBox>

                    <!-- ── Filter Bar ────────────────────────────────── -->
                    <VBox spacing="12" styleClass="filter-bar">
                        <Label text="FILTER LIBRARY" styleClass="filter-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Department" styleClass="filter-label"/>
                                <ComboBox fx:id="departmentFilter" maxWidth="Infinity"
                                          minWidth="120" prefWidth="180" styleClass="field-box"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Semester" styleClass="filter-label"/>
                                <ComboBox fx:id="semesterFilter" maxWidth="Infinity"
                                          minWidth="100" prefWidth="140" styleClass="field-box"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Subject" styleClass="filter-label"/>
                                <ComboBox fx:id="subjectFilter" maxWidth="Infinity"
                                          minWidth="120" prefWidth="220" styleClass="field-box"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Source" styleClass="filter-label"/>
                                <ComboBox fx:id="sourceFilter" maxWidth="Infinity"
                                          minWidth="120" prefWidth="220" styleClass="field-box"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <VBox alignment="BOTTOM_LEFT" spacing="5">
                                <Label text=" " styleClass="filter-label"/>
                                <HBox spacing="8">
                                    <Button onAction="#applyFilters"
                                            styleClass="apply-button" text="Apply Filter"/>
                                    <Button onAction="#clearFilters"
                                            styleClass="clear-button" text="Clear"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ── Tab Pane ──────────────────────────────────── -->
                    <TabPane fx:id="notesTabPane" styleClass="notes-tabs"
                             tabClosingPolicy="UNAVAILABLE">

                        <Tab text="🔒  Personal Notes">
                            <VBox spacing="0" styleClass="tab-content">
                                <VBox fx:id="myNotesContainer" spacing="10"
                                      styleClass="notes-list"/>
                            </VBox>
                        </Tab>

                        <Tab text="👥  Community Notes Status">
                            <VBox spacing="0" styleClass="tab-content">
                                <VBox fx:id="communityNotesContainer" spacing="10"
                                      styleClass="notes-list"/>
                            </VBox>
                        </Tab>
                    </TabPane>

                    <!-- ── Empty State (shown/hidden by controller) ─── -->
                    <VBox fx:id="emptyState" alignment="CENTER" managed="false"
                          spacing="16" styleClass="empty-state-premium" visible="false">
                        <ImageView fitHeight="120" fitWidth="120" preserveRatio="true" styleClass="empty-state-illustration">
                            <image>
                                <Image url="@../images/man_on_lapto.png"/>
                            </image>
                        </ImageView>
                        <Label styleClass="empty-state-text" text="No notes yet"/>
                        <Label styleClass="empty-state-sub"
                               text="Create your first notebook or study guide to get started."/>
                        <Button onAction="#showCreateNoteDialog" styleClass="btn-primary" text="＋  Create Note"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
