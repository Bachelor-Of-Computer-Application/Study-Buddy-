<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="root-pane"
    stylesheets="@../css/theme.css, @../css/questions.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.studybuddy.controllers.QuestionsController">

    <center>
        <StackPane fx:id="stackContainer">

            <!-- ════ 1. FEED PANE ══════════════════════════════════════ -->
            <VBox fx:id="feedPane" spacing="16" styleClass="feed-panel">
                <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>

                <!-- Page header card -->
                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="page-header-card">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="🙋  Q&amp;A Discussion Forum" styleClass="page-title"/>
                        <Label styleClass="page-subtitle"
                               text="Ask questions, upvote best replies, and discuss academic topics with peers."
                               wrapText="true"/>
                    </VBox>
                    <Button onAction="#handleAskQuestion" styleClass="create-button"
                            text="➕  Ask Question"/>
                </HBox>

                <!-- Filter / Search bar -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-section">
                    <TextField fx:id="searchField" prefWidth="240"
                               promptText="🔍  Search questions or tags…"
                               styleClass="form-input"/>
                    <ComboBox fx:id="departmentFilter" prefWidth="160"
                              promptText="Choose Department" styleClass="combo-box"/>
                    <ComboBox fx:id="semesterFilter" prefWidth="120"
                              promptText="Choose Semester" styleClass="combo-box"/>
                    <ComboBox fx:id="subjectFilter" prefWidth="175"
                              promptText="Choose Subject" styleClass="combo-box"/>
                    <Button onAction="#applyFilters" styleClass="save-button" text="Search"/>
                    <Button onAction="#clearFilters" styleClass="cancel-button" text="Reset"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Questions list card -->
                <VBox spacing="12" styleClass="questions-list-card" VBox.vgrow="ALWAYS">
                    <Label text="Active Discussion Threads" styleClass="page-section-title"/>
                    <ListView fx:id="questionsListView" styleClass="activity-list"
                              VBox.vgrow="ALWAYS"/>
                </VBox>
            </VBox>

            <!-- ════ 2. DETAIL PANE ════════════════════════════════════ -->
            <ScrollPane fx:id="detailPane" fitToWidth="true"
                        managed="false" visible="false"
                        styleClass="scroll-pane">
                <content>
                    <VBox spacing="20">
                        <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>

                        <!-- Back Button + header -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <Button onAction="#handleBackToFeed" styleClass="back-button"
                                    text="← Back to Forum"/>
                            <Label text="Discussion Thread" styleClass="detail-section-title"/>
                        </HBox>

                        <!-- Selected question details -->
                        <VBox spacing="14" styleClass="detail-card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="qSubject" styleClass="subject-chip" text="SUBJECT"/>
                                <Label fx:id="qTags" styleClass="tags-label" text="[tags]"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="qDate" styleClass="date-label" text="Date"/>
                            </HBox>

                            <Label fx:id="qText" styleClass="question-text"
                                   text="Question text will appear here." wrapText="true"/>

                            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="detail-meta-row">
                                <Label fx:id="qAuthor" styleClass="meta-label" text="Asked by: —"/>
                                <Label fx:id="qVotes"  styleClass="meta-label" text="👍 0 votes"/>
                                <Label fx:id="qViews"  styleClass="meta-label" text="👁 0 views"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnDeleteQuestion" onAction="#handleDeleteQuestion"
                                        styleClass="cancel-button" text="🗑 Delete Question"
                                        visible="false" managed="false"/>
                                <Button fx:id="btnUpvoteQuestion" onAction="#handleUpvoteQuestion"
                                        styleClass="upvote-button" text="👍  Upvote"/>
                            </HBox>
                        </VBox>

                        <!-- Answers listing -->
                        <VBox spacing="10">
                            <Label text="Classmate Solutions &amp; Answers" styleClass="page-section-title"/>
                            <VBox fx:id="answersContainer" spacing="12"/>
                        </VBox>

                        <!-- Post Answer box -->
                        <VBox spacing="10" styleClass="detail-card">
                            <Label text="Post Your Solution" styleClass="page-section-title"/>
                            <TextArea fx:id="answerInput" prefHeight="100"
                                      promptText="Provide a clear, step-by-step helpful solution…"
                                      styleClass="text-area" wrapText="true"/>
                            <HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button onAction="#handleSubmitAnswer"
                                        styleClass="submit-answer-btn"
                                        text="Submit Answer ✓"/>
                            </HBox>
                        </VBox>

                        <!-- Related questions -->
                        <VBox spacing="10">
                            <Label text="Related Questions" styleClass="related-section-title"/>
                            <VBox fx:id="relatedQuestionsContainer" spacing="8"/>
                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>

        </StackPane>
    </center>

</BorderPane>
