<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="root-pane"
            stylesheets="@../css/theme.css, @../css/dashboard.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.controllers.DashboardController">

    <!-- ═══ Hidden BarChart — keeps @FXML binding alive ═══════════════ -->
    <top>
        <BarChart fx:id="studyBarChart" legendVisible="false" managed="false"
                  prefHeight="0" prefWidth="0" visible="false">
            <xAxis><CategoryAxis label="Subjects" /></xAxis>
            <yAxis><NumberAxis label="Hours" /></yAxis>
        </BarChart>
    </top>

    <!-- ═══ VERTICAL SCROLL ONLY — fitToWidth, no horizontal bar ══════ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="main-scroll">
            <VBox spacing="24" styleClass="main-content">
                <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>

                <!-- ── 1. HERO BANNER ──────────────────────────────────── -->
                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="hero-banner">
                    <!-- Welcome text -->
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label fx:id="welcomeLabel" styleClass="welcome-label" text="Welcome Back! 👋" />
                        <Label styleClass="hero-sub" text="Track your progress, explore notes, and ask questions." />
                    </VBox>
                    <!-- Personal stat chips -->
                    <FlowPane hgap="10" vgap="8" alignment="CENTER" styleClass="hero-chips-row">
                        <VBox alignment="CENTER" spacing="2" styleClass="hero-chip">
                            <Label fx:id="heroLevelLabel" styleClass="hero-chip-value" text="1" />
                            <Label styleClass="hero-chip-label" text="Level" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2" styleClass="hero-chip">
                            <Label fx:id="heroAchievementsLabel" styleClass="hero-chip-value" text="0" />
                            <Label styleClass="hero-chip-label" text="Badges" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2" styleClass="hero-chip">
                            <Label fx:id="heroBestAnswersLabel" styleClass="hero-chip-value" text="0" />
                            <Label styleClass="hero-chip-label" text="Best Ans." />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2" styleClass="hero-chip">
                            <Label fx:id="heroCompletedTasksLabel" styleClass="hero-chip-value" text="0" />
                            <Label styleClass="hero-chip-label" text="Completed" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2" styleClass="hero-chip">
                            <Label fx:id="heroResourcesLabel" styleClass="hero-chip-value" text="0" />
                            <Label styleClass="hero-chip-label" text="Resources" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2" styleClass="hero-chip">
                            <Label fx:id="heroNotesLabel" styleClass="hero-chip-value" text="0" />
                            <Label styleClass="hero-chip-label" text="Notes" />
                        </VBox>
                    </FlowPane>
                    <!-- Points + avatar -->
                    <VBox alignment="CENTER_RIGHT" spacing="3">
                        <Label fx:id="achievementPointsLabel" styleClass="achievement-points-label" text="✨ 0 pts" />
                        <Label styleClass="achievement-points-sub" text="Achievement Points" />
                    </VBox>
                    <StackPane styleClass="hero-avatar-wrap">
                        <ImageView fx:id="heroAvatarView" pickOnBounds="true" />
                    </StackPane>
                </HBox>

                <!-- ── 2. PRIMARY ACTIONS TOOLBAR ─────────────────────── -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="actions-bar">
                    <Button onAction="#handleUploadNotes"
                            styleClass="action-btn, action-btn-indigo" text="📝  Create Note" />
                    <Button onAction="#handleUploadResourceAction"
                            styleClass="action-btn, action-btn-green" text="📤  Upload Resource" />
                    <Button onAction="#handleGoToQuestions"
                            styleClass="action-btn, action-btn-purple" text="🙋  Ask Question" />
                    <Button onAction="#handleGoToAchievements"
                            styleClass="action-btn, action-btn-amber" text="🏆  Achievements" />
                    <Button fx:id="btnDashboardProfile" onAction="#handleGoToProfile"
                            styleClass="action-btn, action-btn-slate" text="👤  Profile" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#refreshDashboard" styleClass="refresh-btn" text="🔄  Refresh" />
                </HBox>

                <!-- ── 3. LEARNING STATISTICS ROW ─────────────────────── -->
                <HBox spacing="20">
                    <!-- Academic Content -->
                    <VBox spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <Label text="Academic Content" styleClass="metric-card-title" />
                        <HBox spacing="0">
                            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <Label text="NOTES" styleClass="metric-label" />
                                <Label fx:id="lblTotalNotes" styleClass="metric-value" text="0" />
                            </VBox>
                            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <Label text="RESOURCES" styleClass="metric-label" />
                                <Label fx:id="lblSharedResources" styleClass="metric-value" text="0" />
                            </VBox>
                            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <Label text="QUESTIONS" styleClass="metric-label" />
                                <Label fx:id="lblTotalQuestions" styleClass="metric-value" text="0" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <!-- Task Status -->
                    <VBox spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <Label text="Task Status" styleClass="metric-card-title" />
                        <HBox spacing="0">
                            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <Label text="TOTAL" styleClass="metric-label" />
                                <Label fx:id="lblTotalTasks" styleClass="metric-value" text="0" />
                            </VBox>
                            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <Label text="DONE" styleClass="metric-label" />
                                <Label fx:id="lblCompletedTasks" styleClass="metric-value metric-success" text="0" />
                            </VBox>
                            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <Label text="PENDING" styleClass="metric-label" />
                                <Label fx:id="lblPendingTasks" styleClass="metric-value metric-warning" text="0" />
                            </VBox>
                            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <Label text="ACTIVE" styleClass="metric-label" />
                                <Label fx:id="lblInProgressTasks" styleClass="metric-value metric-info" text="0" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <!-- Study Progress -->
                    <VBox spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <Label text="Study Progress" styleClass="metric-card-title" />
                        <HBox spacing="0">
                            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <Label text="TASK PROGRESS" styleClass="metric-label" />
                                <Label fx:id="lblProgressPercentageStat" styleClass="metric-value metric-accent" text="0%" />
                            </VBox>
                            <VBox spacing="3" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <Label text="COMPLETION RATE" styleClass="metric-label" />
                                <Label fx:id="lblTaskCompletionPercentage" styleClass="metric-value metric-success" text="0%" />
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- ── 4. STUDY OVERVIEW (65%) + MY UPLOADS (35%) ────── -->
                <GridPane hgap="20" vgap="0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="65" hgrow="ALWAYS" minWidth="400" />
                        <ColumnConstraints percentWidth="35" hgrow="ALWAYS" minWidth="280" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="ALWAYS" />
                    </rowConstraints>

                    <!-- LEFT — Study Overview (primary, larger) -->
                    <VBox spacing="20" styleClass="workspace-panel" GridPane.columnIndex="0">
                        <Label text="Study Overview" styleClass="panel-heading" />
                        <!-- Overall Progress -->
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Overall Progress" styleClass="panel-sub" />
                                <ProgressBar fx:id="overallProgressBar" styleClass="progress-bar"
                                             progress="0" maxWidth="Infinity" />
                            </VBox>
                            <Label fx:id="lblProgressPercentage" styleClass="pct-badge" text="0%" />
                        </HBox>
                        <!-- Recent items — no internal scroll; page scrolls -->
                        <VBox spacing="16">
                            <Label text="Recent Notes" styleClass="recent-section-heading" maxWidth="Infinity" />
                            <HBox fx:id="recentNotesContainer" spacing="12" />
                            <Label text="Recent Resources" styleClass="recent-section-heading" maxWidth="Infinity" />
                            <HBox fx:id="recentResourcesContainer" spacing="12" />
                            <Label text="Recent Questions" styleClass="recent-section-heading" maxWidth="Infinity" />
                            <HBox fx:id="recentQuestionsContainer" spacing="12" />
                            <Label text="Recent Activity" styleClass="recent-section-heading" maxWidth="Infinity" />
                            <HBox fx:id="recentActivityContainer" spacing="12" />
                        </VBox>
                    </VBox>

                    <!-- RIGHT — My Uploads (secondary, smaller) -->
                    <VBox spacing="16" styleClass="workspace-panel" GridPane.columnIndex="1">
                        <!-- Header: title + status badges + refresh -->
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="My Uploads" styleClass="panel-heading" HBox.hgrow="ALWAYS" />
                            <Label fx:id="summaryTotal" styleClass="status-badge" text="0" />
                            <Label fx:id="summaryApproved" styleClass="status-badge status-ok" text="0" />
                            <Label fx:id="summaryPending" styleClass="status-badge status-pend" text="0" />
                            <Label fx:id="summaryRejected" styleClass="status-badge status-rej" text="0" />
                            <Button onAction="#refreshMyUploads" styleClass="refresh-btn" text="↻" />
                        </HBox>
                        <!-- Tabs + search -->
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <HBox spacing="4">
                                <Button fx:id="tabMyNotes" onAction="#handleMyUploadsTabChange"
                                        styleClass="my-uploads-tab-active" text="Notes" />
                                <Button fx:id="tabMyResources" onAction="#handleMyUploadsTabChange"
                                        styleClass="my-uploads-tab" text="Resources" />
                                <Button fx:id="tabMyQuestions" onAction="#handleMyUploadsTabChange"
                                        styleClass="my-uploads-tab" text="Q&amp;A" />
                            </HBox>
                            <TextField fx:id="myUploadsSearchField"
                                       promptText="🔍  Search uploads…"
                                       styleClass="search-field"
                                       HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        </HBox>
                        <!-- Upload cards — expands naturally, page scrolls -->
                        <FlowPane fx:id="myUploadsFlowPane" hgap="12" vgap="12"
                                  styleClass="my-uploads-flow" />
                    </VBox>
                </GridPane>

                <!-- ── 5. COMMUNITY LIBRARY (full width) ──────────────── -->
                <VBox spacing="20" styleClass="workspace-panel">
                    <!-- Header: title + description left | filters right -->
                    <HBox alignment="TOP_LEFT" spacing="20">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Community Library" styleClass="panel-heading" />
                            <Label text="Approved peer-reviewed notes, references, and academic resources shared by the community."
                                   styleClass="panel-sub" wrapText="true" />
                        </VBox>
                        <FlowPane hgap="8" vgap="8" alignment="CENTER_RIGHT">
                            <ComboBox fx:id="departmentComboBox" prefWidth="148" promptText="Department"
                                      styleClass="filter-combo" />
                            <ComboBox fx:id="semesterComboBox" prefWidth="128" promptText="Semester"
                                      styleClass="filter-combo" />
                            <ComboBox fx:id="subjectComboBox" prefWidth="148" promptText="Subject"
                                      styleClass="filter-combo" />
                            <ComboBox fx:id="sortComboBox" prefWidth="118" promptText="Sort By"
                                      styleClass="filter-combo" />
                        </FlowPane>
                    </HBox>
                    <!-- Search row -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="noteSearchField"
                                   promptText="🔍  Search library notes…"
                                   styleClass="search-field"
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Button onAction="#searchNotes" styleClass="primary-btn" text="Search" />
                    </HBox>
                    <!-- Notes grid — expands naturally, page scrolls -->
                    <FlowPane fx:id="notesFlowPane" hgap="14" vgap="14" styleClass="notes-grid" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
