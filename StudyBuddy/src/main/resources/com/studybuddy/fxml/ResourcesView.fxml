<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" styleClass="root-pane"
    stylesheets="@../css/theme.css, @../css/resources.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.studybuddy.controllers.ResourcesController">

    <center>
        <VBox spacing="0">
            <!-- ── Page Header + Filter Area ─────────────────────────── -->
            <VBox spacing="16">
                <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>

                <!-- Header card -->
                <HBox alignment="CENTER_LEFT" spacing="20"
                      styleClass="page-header-card">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="📂  Resource Library" styleClass="page-title"/>
                        <Label styleClass="page-subtitle"
                               text="Find and download academic guides, textbooks, and PDF lecture slides."/>
                    </VBox>
                    <Button onAction="#handleUploadResource" styleClass="upload-btn"
                            text="📤  Upload PDF Resource"/>
                </HBox>

                <!-- Filter bar -->
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
                    <TextField fx:id="searchField" promptText="🔍  Search resources by title…"
                               minWidth="160" prefWidth="220" maxWidth="Infinity"
                               HBox.hgrow="ALWAYS" styleClass="search-field"/>
                    <ComboBox fx:id="departmentFilter" promptText="Department"
                              minWidth="130" prefWidth="155" maxWidth="200" styleClass="combo-box"/>
                    <ComboBox fx:id="semesterFilter" promptText="Semester"
                              minWidth="110" prefWidth="130" maxWidth="180" styleClass="combo-box"/>
                    <ComboBox fx:id="subjectFilter" promptText="Subject"
                              minWidth="120" prefWidth="155" maxWidth="200" styleClass="combo-box"/>
                    <Button onAction="#applyFilters" text="Search"
                            styleClass="save-button"/>
                    <Button onAction="#clearFilters" text="Reset"
                            styleClass="cancel-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- ── Tab Pane ──────────────────────────────────────────── -->
            <VBox VBox.vgrow="ALWAYS">
                <padding><Insets top="16" right="24" bottom="24" left="24" /></padding>
                <TabPane fx:id="resourcesTabPane" tabClosingPolicy="UNAVAILABLE"
                         styleClass="tab-pane" VBox.vgrow="ALWAYS">

                    <!-- Community Library tab -->
                    <Tab text="📚  Community Library">
                        <ScrollPane fitToWidth="true" styleClass="scroll-pane"
                                    vbarPolicy="AS_NEEDED">
                            <content>
                                <VBox spacing="16">
                                    <FlowPane fx:id="resourcesFlowPane" hgap="16" vgap="16"
                                              styleClass="notes-grid"/>
                                    <!-- Empty state -->
                                    <VBox fx:id="emptyState" alignment="CENTER" spacing="16"
                                          styleClass="empty-state-premium" visible="false"
                                          managed="false">
                                        <ImageView fitHeight="100" fitWidth="100" preserveRatio="true" styleClass="empty-state-illustration">
                                            <image>
                                                <Image url="@../images/upload.png"/>
                                            </image>
                                        </ImageView>
                                        <Label text="No approved resources found" styleClass="empty-state-text"/>
                                        <Label text="Upload a PDF or document to share with your peers." styleClass="empty-state-sub"/>
                                        <Button onAction="#handleUploadResource" styleClass="btn-primary" text="📤  Upload Resource"/>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </Tab>

                    <!-- My Upload History tab -->
                    <Tab text="🕒  My Upload History">
                        <VBox spacing="0" styleClass="tab-content" VBox.vgrow="ALWAYS">
                            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="titleCol"    text="Title"         prefWidth="200" minWidth="120"/>
                                    <TableColumn fx:id="subjectCol"  text="Subject"        prefWidth="120" minWidth="80"/>
                                    <TableColumn fx:id="fileNameCol" text="File Name"      prefWidth="140" minWidth="100"/>
                                    <TableColumn fx:id="dateCol"     text="Uploaded Date"  prefWidth="120" minWidth="90"/>
                                    <TableColumn fx:id="statusCol"   text="Status"         prefWidth="90" minWidth="70"/>
                                    <TableColumn fx:id="actionsCol"  text="Actions"        prefWidth="120" minWidth="100"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                </TabPane>
            </VBox>
        </VBox>
    </center>

</BorderPane>
