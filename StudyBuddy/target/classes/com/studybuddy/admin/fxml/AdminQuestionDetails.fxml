<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<ScrollPane fitToWidth="true" fitToHeight="true" styleClass="content-scroll"
            stylesheets="@../../css/theme.css, @../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminQuestionDetailsController">
    <content>
        <VBox spacing="16" styleClass="admin-panel-bg">
            <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblQuestionTitle" text="Question Details" styleClass="section-title"/>
                    <Label fx:id="lblQuestionAuthor" text="by Author" styleClass="section-subtitle"/>
                </VBox>
                <Button text="← Back" styleClass="secondary-btn" onAction="#handleBack"/>
            </HBox>

            <!-- Question Info Card -->
            <VBox styleClass="panel-card" spacing="12">
                <Label text="Question Information" styleClass="panel-title"/>
                <GridPane hgap="15" vgap="8">
                    <Label text="Title:" styleClass="input-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblTitle" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    
                    <Label text="Description:" styleClass="input-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDescription" text="-" wrapText="true" maxWidth="600" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    
                    <Label text="Question Owner:" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="lblOwner" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    
                    <Label text="Reward Points:" styleClass="input-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="lblRewardPoints" text="-" styleClass="highlight-text" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    
                    <Label text="Approval Status:" styleClass="input-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="lblApprovalStatus" text="-" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    
                    <Label text="Reward Status:" styleClass="input-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="lblRewardStatus" text="-" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Department:" styleClass="input-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDepartment" text="-" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label text="Semester:" styleClass="input-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <Label fx:id="lblSemester" text="-" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    <Label text="Subject:" styleClass="input-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <Label fx:id="lblSubject" text="-" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                    <Label text="Date:" styleClass="input-label" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDate" text="-" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <!-- Answers Section -->
            <VBox styleClass="panel-card" spacing="12" VBox.vgrow="ALWAYS">
                <Label text="Answers" styleClass="panel-title"/>
                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                    <VBox fx:id="answersContainer" spacing="12">
                        <!-- Answer cards will be dynamically added here -->
                    </VBox>
                </ScrollPane>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
