<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" stylesheets="@../../css/theme.css, @../css/admin-dashboard.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studybuddy.admin.controllers.AdminUserDetailsController"
      styleClass="admin-panel-bg"
      padding="24 24 24 24">
    
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3">
            <Label fx:id="lblUserName" text="User Details" styleClass="section-title"/>
            <Label fx:id="lblUserEmail" text="email@example.com" styleClass="section-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Close" styleClass="secondary-btn" onAction="#handleClose"/>
    </HBox>
    
    <!-- Personal Info -->
    <VBox styleClass="panel-card" spacing="10">
        <Label text="Personal Information" styleClass="panel-title"/>
        <GridPane hgap="10" vgap="8">
            <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblFullName" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            
            <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblName" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            
            <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblEmail" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            
            <Label text="Registration Date:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="lblRegDate" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            
            <Label text="Last Login:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="lblLastLogin" text="-" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>
    
    <!-- Academic Info -->
    <VBox styleClass="panel-card" spacing="10">
        <Label text="Academic Information" styleClass="panel-title"/>
        <GridPane hgap="10" vgap="8">
            <Label text="Department:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblDepartment" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            
            <Label text="Semester:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblSemester" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            
            <Label text="Role:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblRole" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            
            <Label text="Account Status:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="lblStatus" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            
            <Label text="Points:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="lblPoints" text="-" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>
    
    <!-- Contribution Statistics -->
    <VBox styleClass="panel-card" spacing="10">
        <Label text="Contribution Statistics" styleClass="panel-title"/>
        <GridPane hgap="10" vgap="8">
            <Label text="Total Notes:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblTotalNotes" text="0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            
            <Label text="Total Resources:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblTotalResources" text="0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            
            <Label text="Total Questions:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblTotalQuestions" text="0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>
    
    <!-- Recent Uploads -->
    <VBox styleClass="panel-card" spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Recent Uploads" styleClass="panel-title"/>
        <TableView fx:id="tblRecentUploads" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colItemType" text="Type" prefWidth="100"/>
                <TableColumn fx:id="colItemTitle" text="Title" prefWidth="250"/>
                <TableColumn fx:id="colItemStatus" text="Status" prefWidth="100"/>
                <TableColumn fx:id="colItemDate" text="Date" prefWidth="180"/>
            </columns>
        </TableView>
    </VBox>
    
    <!-- Approval History -->
    <VBox styleClass="panel-card" spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Approval History" styleClass="panel-title"/>
        <TableView fx:id="tblApprovalHistory" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colHistoryType" text="Type" prefWidth="100"/>
                <TableColumn fx:id="colHistoryTitle" text="Title" prefWidth="250"/>
                <TableColumn fx:id="colHistoryStatus" text="Status" prefWidth="100"/>
                <TableColumn fx:id="colHistoryDate" text="Date" prefWidth="180"/>
            </columns>
        </TableView>
    </VBox>
    
</VBox>
