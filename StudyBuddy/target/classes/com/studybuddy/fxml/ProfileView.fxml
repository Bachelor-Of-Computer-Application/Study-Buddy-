<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="root-pane"
    stylesheets="@../css/theme.css, @../css/profile.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.studybuddy.controllers.ProfileController">

    <!-- ══ LEFT – Profile sidebar ════════════════════════════════════ -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="260" spacing="16"
              styleClass="profile-sidebar">
            <padding><Insets top="32" right="20" bottom="32" left="20"/></padding>

            <!-- Avatar -->
            <StackPane fx:id="avatarStackPane" styleClass="avatar-stack">
                <StackPane styleClass="avatar-circle">
                    <ImageView fx:id="profileImageView" pickOnBounds="true"/>
                </StackPane>
                <VBox fx:id="avatarHoverOverlay" alignment="CENTER" spacing="4"
                      styleClass="avatar-hover-overlay" mouseTransparent="true">
                    <Label text="📷" styleClass="avatar-hover-icon"/>
                    <Label text="Change Photo" styleClass="avatar-hover-text"/>
                </VBox>
            </StackPane>

            <!-- Name + username -->
            <VBox alignment="CENTER" spacing="4">
                <Label fx:id="displayNameLabel" styleClass="display-name" text="Full Name"/>
                <Label fx:id="usernameSubLabel" styleClass="username-subtext" text="@username"/>
            </VBox>

            <!-- Points card -->
            <VBox alignment="CENTER" spacing="6" styleClass="points-card">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="✨  ACHIEVEMENT POINTS" styleClass="points-title"/>
                <Label fx:id="pointsBadgeLabel" styleClass="points-value" text="0 pts"/>
            </VBox>

            <!-- Member info card -->
            <VBox spacing="10" styleClass="meta-card">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="MEMBER INFO" styleClass="meta-title"/>
                <Label fx:id="joinedDateLabel" styleClass="meta-item" text="📅 Joined: —"/>
                <Label fx:id="userRoleLabel"   styleClass="meta-item" text="🎓 Role: Student"/>
            </VBox>
        </VBox>
    </left>

    <!-- ══ CENTER – Tabbed profile content ═══════════════════════════ -->
    <center>
        <TabPane fx:id="profileTabPane" styleClass="profile-tabs"
                 tabClosingPolicy="UNAVAILABLE">

            <!-- ── 1. OVERVIEW ──────────────────────────────────────── -->
            <Tab text="Overview">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox spacing="20" styleClass="tab-content">
                        <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>

                        <Label text="Profile Overview" styleClass="section-header"/>

                        <!-- Details grid -->
                        <GridPane hgap="20" vgap="0" styleClass="details-grid">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="30"/>
                                <ColumnConstraints percentWidth="70"/>
                            </columnConstraints>
                            <Label text="Full Name:"      styleClass="field-label-bold" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="ovFullName"     styleClass="field-value"      GridPane.columnIndex="1" GridPane.rowIndex="0" text="—"/>
                            <Label text="Username:"       styleClass="field-label-bold" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="ovUsername"     styleClass="field-value"      GridPane.columnIndex="1" GridPane.rowIndex="1" text="—"/>
                            <Label text="Email:"          styleClass="field-label-bold" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="ovEmail"        styleClass="field-value"      GridPane.columnIndex="1" GridPane.rowIndex="2" text="—"/>
                            <Label text="Phone:"          styleClass="field-label-bold" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <Label fx:id="ovPhone"        styleClass="field-value"      GridPane.columnIndex="1" GridPane.rowIndex="3" text="—"/>
                            <Label text="Bio:"            styleClass="field-label-bold" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <Label fx:id="ovBio"          styleClass="field-value"      GridPane.columnIndex="1" GridPane.rowIndex="4" text="—" wrapText="true"/>
                            <Label text="Department:"     styleClass="field-label-bold" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                            <Label fx:id="ovDept"         styleClass="field-value"      GridPane.columnIndex="1" GridPane.rowIndex="5" text="—"/>
                            <Label text="Semester:"       styleClass="field-label-bold" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                            <Label fx:id="ovSemester"     styleClass="field-value"      GridPane.columnIndex="1" GridPane.rowIndex="6" text="—"/>
                            <Label text="Interests:"      styleClass="field-label-bold" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                            <Label fx:id="ovInterests"    styleClass="field-value"      GridPane.columnIndex="1" GridPane.rowIndex="7" text="—" wrapText="true"/>
                            <rowConstraints>
                                <RowConstraints/><RowConstraints/><RowConstraints/><RowConstraints/>
                                <RowConstraints/><RowConstraints/><RowConstraints/><RowConstraints/>
                            </rowConstraints>
                        </GridPane>

                        <!-- Activity stats -->
                        <Label text="Activity Stats" styleClass="section-header"/>
                        <GridPane hgap="14" vgap="14">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.3"/>
                                <ColumnConstraints percentWidth="33.3"/>
                                <ColumnConstraints percentWidth="33.3"/>
                            </columnConstraints>
                            <VBox styleClass="stat-card" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Notes Created"       styleClass="stat-label"/>
                                <Label fx:id="statNotesCreated"   styleClass="stat-number" text="0"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Resources Uploaded"     styleClass="stat-label"/>
                                <Label fx:id="statResourcesUploaded" styleClass="stat-number" text="0"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Questions Asked"     styleClass="stat-label"/>
                                <Label fx:id="statQuestionsAsked" styleClass="stat-number" text="0"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Answers Posted"   styleClass="stat-label"/>
                                <Label fx:id="statAnswersPosted" styleClass="stat-number" text="0"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Study Hours"    styleClass="stat-label"/>
                                <Label fx:id="statStudyHours" styleClass="stat-number" text="0.0h"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <Label text="Achievements"     styleClass="stat-label"/>
                                <Label fx:id="statAchievements" styleClass="stat-number" text="0"/>
                            </VBox>
                            <rowConstraints><RowConstraints/><RowConstraints/></rowConstraints>
                        </GridPane>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ── 2. EDIT PROFILE ──────────────────────────────────── -->
            <Tab text="Edit Profile">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox spacing="16" styleClass="tab-content">
                        <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
                        <Label text="Edit Personal Details" styleClass="section-header"/>

                        <VBox spacing="6">
                            <Label text="Profile Picture" styleClass="field-title"/>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Button fx:id="uploadAvatarBtn" onAction="#handleUploadAvatar"
                                        styleClass="secondary-btn" text="📷 Choose Image…"/>
                                <Button fx:id="removeAvatarBtn" onAction="#handleRemoveAvatar"
                                        styleClass="secondary-btn" text="🗑 Remove Photo"/>
                                <Label fx:id="avatarPathLabel" styleClass="help-text" text="Using default avatar"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Full Name" styleClass="field-title"/>
                            <TextField fx:id="fullNameField" styleClass="input-box" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Username" styleClass="field-title"/>
                            <TextField fx:id="usernameField" styleClass="input-box" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Phone Number" styleClass="field-title"/>
                            <TextField fx:id="phoneNumberField" styleClass="input-box" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Bio" styleClass="field-title"/>
                            <TextArea fx:id="bioField" prefHeight="80" styleClass="input-box"
                                      wrapText="true" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Department" styleClass="field-title"/>
                            <ComboBox fx:id="departmentField"
                                      styleClass="input-box"
                                      maxWidth="Infinity"/>
                        </VBox>


                        <VBox spacing="6">
                            <Label text="Semester" styleClass="field-title"/>
                            <ComboBox fx:id="semesterCombo"
                                      styleClass="input-box"
                                      maxWidth="Infinity"/>
                        </VBox>


                        <HBox spacing="10">
                            <Button onAction="#handleSavePersonal" styleClass="primary-btn" text="💾 Save Personal Info"/>
                            <Button onAction="#handleResetPersonal" styleClass="secondary-btn" text="Reset"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ── 3. STUDY INTERESTS ───────────────────────────────── -->
            <Tab text="Study Interests">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox spacing="16" styleClass="tab-content">
                        <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
                        <Label text="Study Interests &amp; Preferences" styleClass="section-header"/>
                        <VBox spacing="6">
                            <Label text="Preferred Subjects" styleClass="field-title"/>
                            <TextField fx:id="preferredSubjectsField"
                                       promptText="e.g. Mathematics, Physics"
                                       styleClass="input-box" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Study Goals" styleClass="field-title"/>
                            <TextArea fx:id="studyGoalsField" prefHeight="100"
                                      promptText="What are your goals?" styleClass="input-box"
                                      wrapText="true" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Learning Interests" styleClass="field-title"/>
                            <TextField fx:id="learningInterestsField"
                                       promptText="e.g. Machine Learning, Astrophotography"
                                       styleClass="input-box" maxWidth="Infinity"/>
                        </VBox>
                        <Button onAction="#handleSaveStudyPreferences"
                                styleClass="primary-btn" text="💾 Save Preferences"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ── 4. ACCOUNT SETTINGS ──────────────────────────────── -->
            <Tab text="Account Settings">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox spacing="16" styleClass="tab-content">
                        <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
                        <Label text="Account &amp; Security Settings" styleClass="section-header"/>
                        <VBox spacing="6">
                            <Label text="Email Address" styleClass="field-title"/>
                            <TextField fx:id="emailField" styleClass="input-box" maxWidth="Infinity"/>
                        </VBox>
                        <Button onAction="#handleSaveAccount"
                                styleClass="primary-btn" text="Update Email"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ── 5. PASSWORD ──────────────────────────────────────── -->
            <Tab text="Password">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox spacing="16" styleClass="tab-content">
                        <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
                        <Label text="Change Password" styleClass="section-header"/>
                        <VBox spacing="6">
                            <Label text="Current Password" styleClass="field-title"/>
                            <PasswordField fx:id="currentPasswordField" styleClass="input-box" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="New Password" styleClass="field-title"/>
                            <PasswordField fx:id="newPasswordField" styleClass="input-box" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Confirm New Password" styleClass="field-title"/>
                            <PasswordField fx:id="confirmPasswordField" styleClass="input-box" maxWidth="Infinity"/>
                        </VBox>
                        <Button onAction="#handleSavePassword"
                                styleClass="primary-btn" text="🔒 Update Password"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ── 6. NOTIFICATIONS ─────────────────────────────────── -->
            <Tab text="Notifications">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox spacing="16" styleClass="tab-content">
                        <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
                        <Label text="Notification Preferences" styleClass="section-header"/>
                        <CheckBox fx:id="emailNotificationsCheck"
                                  styleClass="checkbox-style"
                                  text="Receive general email notifications"/>
                        <CheckBox fx:id="resourceNotificationsCheck"
                                  styleClass="checkbox-style"
                                  text="Notify me when resources are updated"/>
                        <CheckBox fx:id="systemNotificationsCheck"
                                  styleClass="checkbox-style"
                                  text="Receive critical system updates and moderator alerts"/>
                        <Button onAction="#handleSaveNotifications"
                                styleClass="primary-btn" text="💾 Save Preferences"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ── 7. ACHIEVEMENTS ──────────────────────────────────── -->
            <Tab text="Achievements">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox spacing="12" styleClass="tab-content">
                        <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
                        <Label text="Achievements &amp; Badges" styleClass="section-header"/>
                        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="badge-row">
                            <Label text="🥇" styleClass="badge-icon"/>
                            <VBox spacing="3">
                                <Label text="First Step" styleClass="badge-name"/>
                                <Label text="Registered an account on Study Buddy." styleClass="badge-desc"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="badge-row">
                            <Label text="📝" styleClass="badge-icon"/>
                            <VBox spacing="3">
                                <Label text="Note Scholar" styleClass="badge-name"/>
                                <Label text="Created your first personal study notes." styleClass="badge-desc"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="badge-row">
                            <Label text="🙋" styleClass="badge-icon"/>
                            <VBox spacing="3">
                                <Label text="Curious Learner" styleClass="badge-name"/>
                                <Label text="Asked an academic question to the community." styleClass="badge-desc"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ── 8. ACTIVITY ──────────────────────────────────────── -->
            <Tab text="Activity">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox spacing="16" styleClass="tab-content">
                        <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
                        <Label text="Recent Activities" styleClass="section-header"/>
                        <ListView fx:id="activityListView" prefHeight="350"
                                  styleClass="activity-list"/>
                    </VBox>
                </ScrollPane>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
