<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="root-pane" stylesheets="@../css/theme.css, @../css/dashboard.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.studybuddy.controllers.DashboardController">

    <!-- ═══ HIDDEN BarChart – keeps @FXML binding alive, never rendered ═ -->
    <!-- The controller's studyBarChart field is kept wired to avoid NPE.  -->
    <top>
        <BarChart fx:id="studyBarChart" managed="false" visible="false" prefHeight="0" prefWidth="0" legendVisible="false">
            <xAxis>
                <CategoryAxis label="Subjects"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Hours"/>
            </yAxis>
        </BarChart>
    </top>

    <!-- ═══ SCROLLABLE DASHBOARD CONTENT ════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <content>
                <VBox spacing="20" styleClass="main-content">
                    <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>

                    <!-- ── Hero Banner ─────────────────────────────────── -->
                    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="hero-banner">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label fx:id="welcomeLabel" styleClass="welcome-label" text="Welcome Back! 👋"/>
                            <Label styleClass="hero-sub" text="Track your progress, explore notes, and ask questions."/>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="4">
                            <Label fx:id="achievementPointsLabel" styleClass="achievement-points-label" text="✨ 0 pts"/>
                            <Label styleClass="achievement-points-sub" text="Achievement Points"/>
                        </VBox>
                        <StackPane styleClass="hero-avatar-wrap">
                            <ImageView fx:id="heroAvatarView" pickOnBounds="true"/>
                        </StackPane>
                    </HBox>

                    <!-- ── Achievement Stats Row ─────────────────────────── -->
                    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="achievement-stats-row">
                        <VBox spacing="2" alignment="CENTER">
                            <Label fx:id="heroLevelLabel" styleClass="hero-stat-value" text="Level 1"/>
                            <Label styleClass="hero-stat-label" text="Current Level"/>
                        </VBox>
                        <VBox spacing="2" alignment="CENTER">
                            <Label fx:id="heroAchievementsLabel" styleClass="hero-stat-value" text="0"/>
                            <Label styleClass="hero-stat-label" text="Achievements"/>
                        </VBox>
                        <VBox spacing="2" alignment="CENTER">
                            <Label fx:id="heroBestAnswersLabel" styleClass="hero-stat-value" text="0"/>
                            <Label styleClass="hero-stat-label" text="Best Answers"/>
                        </VBox>
                        <VBox spacing="2" alignment="CENTER">
                            <Label fx:id="heroCompletedTasksLabel" styleClass="hero-stat-value" text="0"/>
                            <Label styleClass="hero-stat-label" text="Completed Tasks"/>
                        </VBox>
                        <VBox spacing="2" alignment="CENTER">
                            <Label fx:id="heroResourcesLabel" styleClass="hero-stat-value" text="0"/>
                            <Label styleClass="hero-stat-label" text="Resources Shared"/>
                        </VBox>
                        <VBox spacing="2" alignment="CENTER">
                            <Label fx:id="heroNotesLabel" styleClass="hero-stat-value" text="0"/>
                            <Label styleClass="hero-stat-label" text="Notes Uploaded"/>
                        </VBox>
                    </HBox>

                    <!-- ── Quick Actions ───────────────────────────────── -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Quick Actions:" styleClass="section-label"/>
                        <Button onAction="#handleUploadNotes" styleClass="quick-action-btn, quick-btn-note" text="📝 Create Note"/>
                        <Button onAction="#handleUploadResourceAction" styleClass="quick-action-btn, quick-btn-resource" text="📤 Upload Resource"/>
                        <Button onAction="#handleGoToQuestions" styleClass="quick-action-btn, quick-btn-question" text="🙋 Ask Question"/>
                        <Button onAction="#handleGoToAchievements" styleClass="quick-action-btn, quick-btn-achievement" text="🏆 Achievements"/>
                        <Button onAction="#handleGoToProfile" styleClass="quick-action-btn, quick-btn-profile" text="👤 Profile"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#refreshDashboard" styleClass="refresh-btn" text="🔄 Refresh"/>
                    </HBox>

                    <!-- ── 5-Column Stat Cards ─────────────────────────── -->
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints/>
                        </rowConstraints>

                        <!-- Card 1: Notes -->
                        <VBox styleClass="stat-card-premium" GridPane.columnIndex="0" spacing="8">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <HBox alignment="CENTER" styleClass="stat-icon-wrap, stat-icon-wrap-indigo">
                                    <Label text="📝" styleClass="stat-icon-sm"/>
                                </HBox>
                                <VBox spacing="2">
                                    <Label text="NOTES" styleClass="stat-label"/>
                                    <Label fx:id="lblTotalNotes" styleClass="stat-value" text="0"/>
                                </VBox>
                            </HBox>
                            <Label text="Created notebooks" styleClass="stat-desc"/>
                        </VBox>

                        <!-- Card 2: Resources -->
                        <VBox styleClass="stat-card-premium" GridPane.columnIndex="1" spacing="8">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <HBox alignment="CENTER" styleClass="stat-icon-wrap, stat-icon-wrap-sky">
                                    <Label text="📂" styleClass="stat-icon-sm"/>
                                </HBox>
                                <VBox spacing="2">
                                    <Label text="RESOURCES" styleClass="stat-label"/>
                                    <Label fx:id="lblSharedResources" styleClass="stat-value" text="0"/>
                                </VBox>
                            </HBox>
                            <Label text="Shared documents" styleClass="stat-desc"/>
                        </VBox>

                        <!-- Card 3: Questions -->
                        <VBox styleClass="stat-card-premium" GridPane.columnIndex="2" spacing="8">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <HBox alignment="CENTER" styleClass="stat-icon-wrap, stat-icon-wrap-purple">
                                    <Label text="🙋" styleClass="stat-icon-sm"/>
                                </HBox>
                                <VBox spacing="2">
                                    <Label text="QUESTIONS" styleClass="stat-label"/>
                                    <Label fx:id="lblTotalQuestions" styleClass="stat-value" text="0"/>
                                </VBox>
                            </HBox>
                            <Label text="Asked topics" styleClass="stat-desc"/>
                        </VBox>

                        <!-- Card 4: Tasks -->
                        <VBox styleClass="stat-card-premium" GridPane.columnIndex="3" spacing="8">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <HBox alignment="CENTER" styleClass="stat-icon-wrap, stat-icon-wrap-amber">
                                    <Label text="✅" styleClass="stat-icon-sm"/>
                                </HBox>
                                <VBox spacing="2">
                                    <Label text="TASKS" styleClass="stat-label"/>
                                    <Label fx:id="lblTotalTasks" styleClass="stat-value" text="0"/>
                                </VBox>
                            </HBox>
                            <Label text="Total tasks" styleClass="stat-desc"/>
                        </VBox>

                        <!-- Card 5: Progress -->
                        <VBox styleClass="stat-card-premium" GridPane.columnIndex="4" spacing="8">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <HBox alignment="CENTER" styleClass="stat-icon-wrap, stat-icon-wrap-green">
                                    <Label text="📈" styleClass="stat-icon-sm"/>
                                </HBox>
                                <VBox spacing="2">
                                    <Label text="PROGRESS" styleClass="stat-label"/>
                                    <Label fx:id="lblProgressPercentageStat" styleClass="stat-value, stat-value-success" text="0%"/>
                                </VBox>
                            </HBox>
                            <Label text="Tasks completion" styleClass="stat-desc"/>
                        </VBox>
                    </GridPane>
                    
                    <!-- ── 4 Task Stat Cards ───────────────────────────── -->
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints/>
                        </rowConstraints>
                        
                        <!-- Task Card 1: Completed -->
                        <VBox styleClass="stat-card-premium" GridPane.columnIndex="0" spacing="8">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <HBox alignment="CENTER" styleClass="stat-icon-wrap, stat-icon-wrap-green">
                                    <Label text="✅" styleClass="stat-icon-sm"/>
                                </HBox>
                                <VBox spacing="2">
                                    <Label text="COMPLETED" styleClass="stat-label"/>
                                    <Label fx:id="lblCompletedTasks" styleClass="stat-value, stat-value-success" text="0"/>
                                </VBox>
                            </HBox>
                            <Label text="Completed tasks" styleClass="stat-desc"/>
                        </VBox>
                        
                        <!-- Task Card 2: Pending -->
                        <VBox styleClass="stat-card-premium" GridPane.columnIndex="1" spacing="8">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <HBox alignment="CENTER" styleClass="stat-icon-wrap, stat-icon-wrap-amber">
                                    <Label text="⏳" styleClass="stat-icon-sm"/>
                                </HBox>
                                <VBox spacing="2">
                                    <Label text="PENDING" styleClass="stat-label"/>
                                    <Label fx:id="lblPendingTasks" styleClass="stat-value" text="0"/>
                                </VBox>
                            </HBox>
                            <Label text="Pending tasks" styleClass="stat-desc"/>
                        </VBox>
                        
                        <!-- Task Card 3: In Progress -->
                        <VBox styleClass="stat-card-premium" GridPane.columnIndex="2" spacing="8">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <HBox alignment="CENTER" styleClass="stat-icon-wrap, stat-icon-wrap-sky">
                                    <Label text="🔄" styleClass="stat-icon-sm"/>
                                </HBox>
                                <VBox spacing="2">
                                    <Label text="IN PROGRESS" styleClass="stat-label"/>
                                    <Label fx:id="lblInProgressTasks" styleClass="stat-value" text="0"/>
                                </VBox>
                            </HBox>
                            <Label text="In progress tasks" styleClass="stat-desc"/>
                        </VBox>
                        
                        <!-- Task Card 4: Completion Rate -->
                        <VBox styleClass="stat-card-premium" GridPane.columnIndex="3" spacing="8">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <HBox alignment="CENTER" styleClass="stat-icon-wrap, stat-icon-wrap-purple">
                                    <Label text="🎯" styleClass="stat-icon-sm"/>
                                </HBox>
                                <VBox spacing="2">
                                    <Label text="COMPLETION %" styleClass="stat-label"/>
                                    <Label fx:id="lblTaskCompletionPercentage" styleClass="stat-value, stat-value-success" text="0%"/>
                                </VBox>
                            </HBox>
                            <Label text="Task completion rate" styleClass="stat-desc"/>
                        </VBox>
                    </GridPane>

                    <!-- ── Progress + Widgets Row ──────────────────────── -->
                    <HBox alignment="TOP_LEFT" spacing="16">

                        <!-- Progress Card -->
                        <VBox spacing="14" styleClass="panel-card" prefWidth="260">
                            <Label text="Overall Study Progress" styleClass="panel-title"/>
                            <VBox alignment="CENTER" spacing="10">
                                <Label fx:id="lblProgressPercentage" styleClass="progress-pct" text="0%"/>
                                <ProgressBar fx:id="overallProgressBar" styleClass="progress-bar" progress="0" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Rank: Apprentice Scholar" styleClass="progress-meta"/>
                                <Label text="Keep it up! 🎯" styleClass="progress-meta"/>
                            </VBox>
                        </VBox>

                        <!-- Widget 1: Recent Notes -->
                        <VBox spacing="10" styleClass="widget-card" HBox.hgrow="ALWAYS">
                            <Label text="📝  Recent Notes" styleClass="widget-title"/>
                            <HBox fx:id="recentNotesContainer" spacing="10"/>
                        </VBox>

                        <!-- Widget 2: Recent Resources -->
                        <VBox spacing="10" styleClass="widget-card" HBox.hgrow="ALWAYS">
                            <Label text="📂  Recent Resources" styleClass="widget-title"/>
                            <HBox fx:id="recentResourcesContainer" spacing="10"/>
                        </VBox>

                        <!-- Widget 3: Recent Questions -->
                        <VBox spacing="10" styleClass="widget-card" HBox.hgrow="ALWAYS">
                            <Label text="🙋  Recent Questions" styleClass="widget-title"/>
                            <HBox fx:id="recentQuestionsContainer" spacing="10"/>
                        </VBox>
                    </HBox>

                    <!-- ── Recent Activity Row ─────────────────────────── -->
                    <VBox spacing="10" styleClass="widget-card">
                        <Label text="⚡  Recent Activity" styleClass="widget-title"/>
                        <HBox fx:id="recentActivityContainer" spacing="10"/>
                    </VBox>

                    <!-- ── My Uploads ──────────────────────────────────── -->
                    <VBox spacing="16" styleClass="panel-card">
                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="📤  My Uploads" styleClass="library-section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="myUploadsSearchField" prefWidth="220" promptText="🔍  Search your uploads..." styleClass="search-field"/>
                            <Button onAction="#refreshMyUploads" styleClass="refresh-btn" text="↻ Refresh"/>
                        </HBox>
                        
                        <!-- Segmented Tabs -->
                        <HBox spacing="8">
                            <Button fx:id="tabMyNotes" onAction="#handleMyUploadsTabChange" styleClass="my-uploads-tab-active" text="📝 My Notes"/>
                            <Button fx:id="tabMyResources" onAction="#handleMyUploadsTabChange" styleClass="my-uploads-tab" text="📂 My Resources"/>
                            <Button fx:id="tabMyQuestions" onAction="#handleMyUploadsTabChange" styleClass="my-uploads-tab" text="🙋 My Questions"/>
                        </HBox>
                        
                        <!-- Upload List (FlowPane for cards) -->
                        <ScrollPane fitToWidth="true" styleClass="scroll-pane-clean" prefHeight="320">
                            <FlowPane fx:id="myUploadsFlowPane" hgap="12" vgap="12" styleClass="my-uploads-flow"/>
                        </ScrollPane>
                        
                        <!-- Bottom Summary Cards -->
                        <GridPane hgap="12" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>
                            
                            <VBox styleClass="stat-card-premium" GridPane.columnIndex="0" spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <HBox alignment="CENTER" styleClass="stat-icon-wrap stat-icon-wrap-indigo">
                                        <Label text="📤" styleClass="stat-icon-sm"/>
                                    </HBox>
                                    <VBox spacing="2">
                                        <Label text="TOTAL" styleClass="stat-label"/>
                                        <Label fx:id="summaryTotal" styleClass="stat-value" text="0"/>
                                    </VBox>
                                </HBox>
                                <Label text="Total uploads" styleClass="stat-desc"/>
                            </VBox>
                            
                            <VBox styleClass="stat-card-premium" GridPane.columnIndex="1" spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <HBox alignment="CENTER" styleClass="stat-icon-wrap stat-icon-wrap-green">
                                        <Label text="✅" styleClass="stat-icon-sm"/>
                                    </HBox>
                                    <VBox spacing="2">
                                        <Label text="APPROVED" styleClass="stat-label"/>
                                        <Label fx:id="summaryApproved" styleClass="stat-value stat-value-success" text="0"/>
                                    </VBox>
                                </HBox>
                                <Label text="Approved items" styleClass="stat-desc"/>
                            </VBox>
                            
                            <VBox styleClass="stat-card-premium" GridPane.columnIndex="2" spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <HBox alignment="CENTER" styleClass="stat-icon-wrap stat-icon-wrap-amber">
                                        <Label text="⏳" styleClass="stat-icon-sm"/>
                                    </HBox>
                                    <VBox spacing="2">
                                        <Label text="PENDING" styleClass="stat-label"/>
                                        <Label fx:id="summaryPending" styleClass="stat-value" text="0"/>
                                    </VBox>
                                </HBox>
                                <Label text="Pending approval" styleClass="stat-desc"/>
                            </VBox>
                            
                            <VBox styleClass="stat-card-premium" GridPane.columnIndex="3" spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <HBox alignment="CENTER" styleClass="stat-icon-wrap stat-icon-wrap-purple">
                                        <Label text="❌" styleClass="stat-icon-sm"/>
                                    </HBox>
                                    <VBox spacing="2">
                                        <Label text="REJECTED" styleClass="stat-label"/>
                                        <Label fx:id="summaryRejected" styleClass="stat-value" text="0"/>
                                    </VBox>
                                </HBox>
                                <Label text="Rejected items" styleClass="stat-desc"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- ── Community Library ───────────────────────────── -->
                    <VBox spacing="14" styleClass="panel-card">
                        <Label text="Approved Community Library" styleClass="library-section-title"/>

                        <!-- Filter row -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <ComboBox fx:id="departmentComboBox" prefWidth="160" promptText="Choose Department" styleClass="filter-combo"/>
                            <ComboBox fx:id="semesterComboBox" prefWidth="140" promptText="Choose Semester" styleClass="filter-combo"/>
                            <ComboBox fx:id="subjectComboBox" prefWidth="175" promptText="Choose Subject" styleClass="filter-combo"/>
                            <ComboBox fx:id="sortComboBox" prefWidth="145" promptText="Sort By" styleClass="filter-combo"/>
                            <TextField fx:id="noteSearchField" prefWidth="200" promptText="🔍  Search library notes…" styleClass="search-field"/>
                            <Button onAction="#searchNotes" styleClass="filter-btn" text="Filter"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <!-- Notes Flow Pane -->
                        <ScrollPane fitToWidth="true" styleClass="scroll-pane" vbarPolicy="NEVER" prefHeight="220">
                            <FlowPane fx:id="notesFlowPane" hgap="14" vgap="14" styleClass="notes-grid"/>
                        </ScrollPane>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
