<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Main dashboard shell: sidebar (left) + content (center) -->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminDashboardController"
            stylesheets="@../css/admin-dashboard.css"
            styleClass="root-pane">

    <!-- ══ LEFT SIDEBAR ══════════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="4"
              prefWidth="240" minWidth="240">
            <padding><Insets top="20" right="14" bottom="20" left="14"/></padding>

            <!-- Brand -->
            <HBox styleClass="brand-box" spacing="10" alignment="CENTER_LEFT">
                <padding><Insets bottom="4"/></padding>
                <Label text="📚" styleClass="brand-icon"/>
                <VBox spacing="1">
                    <Label text="StudyBuddy" styleClass="brand-title"/>
                    <Label text="Admin Panel" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Global search -->
            <TextField fx:id="globalSearchField"
                       promptText="🔍  Global search…"
                       styleClass="search-field"
                       style="-fx-background-color: #1e293b; -fx-text-fill: #94a3b8; -fx-border-color: #334155; -fx-prompt-text-fill: #64748b;"
                       maxWidth="Infinity">
                <VBox.margin><Insets top="6" bottom="4"/></VBox.margin>
            </TextField>

            <Separator styleClass="sidebar-separator"/>

            <!-- Navigation section -->
            <Label text="NAVIGATION" styleClass="nav-section-label"/>

            <VBox spacing="2" VBox.vgrow="ALWAYS">
                <Button fx:id="btnOverview"
                        text="📊  Overview"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showOverview"/>
                <Button fx:id="btnUsers"
                        text="👥  Users"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showUsers"/>
                <Button fx:id="btnNotes"
                        text="📝  Notes"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showNotes"/>
                <Button fx:id="btnResources"
                        text="📂  Resources"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showResources"/>
                <Button fx:id="btnQuestions"
                        text="❓  Questions"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showQuestions"/>
                <Button fx:id="btnReports"
                        text="📈  Reports"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showReports"/>
                <Button fx:id="btnNotifications"
                        text="🔔  Notifications"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showNotifications"/>
                <Button fx:id="btnActivityLogs"
                        text="📋  Activity Logs"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showActivityLogs"/>
                <Button fx:id="btnSettings"
                        text="⚙️  Settings"
                        styleClass="nav-btn"
                        maxWidth="Infinity"
                        onAction="#showSettings"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Admin info box -->
            <HBox styleClass="admin-info-box" spacing="10" alignment="CENTER_LEFT">
                <VBox styleClass="admin-avatar" alignment="CENTER">
                    <Label styleClass="admin-avatar-label" text="A"/>
                </VBox>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="adminNameLabel" text="Administrator" styleClass="admin-name-label"/>
                    <Label fx:id="adminRoleLabel" text="ADMIN" styleClass="admin-role-label"/>
                </VBox>
            </HBox>

            <Button text="🚪  Logout"
                    styleClass="logout-btn"
                    maxWidth="Infinity"
                    onAction="#handleLogout">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- ══ DYNAMIC CONTENT AREA ══════════════════════════════════════ -->
    <center>
        <StackPane fx:id="adminContentArea" styleClass="admin-content-area"/>
    </center>

</BorderPane>
