<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" stylesheets="@../css/admin-dashboard.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studybuddy.admin.controllers.AdminUsersController"
      style="-fx-background-color: #f1f5f9;">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="User Management" styleClass="section-title"/>
            <Label fx:id="lblTotalCount" text="Loading…" styleClass="section-subtitle"/>
        </VBox>
        <Button text="↻ Refresh" styleClass="secondary-btn" onAction="#handleRefresh"/>
        <Button text="📤 Export CSV" styleClass="secondary-btn" onAction="#handleExport"/>
    </HBox>

    <!-- Filter Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
        <TextField fx:id="searchField" promptText="🔍  Search name or email…"
                   styleClass="search-field" prefWidth="240"/>
        <ComboBox fx:id="roleFilter" promptText="All Roles" styleClass="combo-box" prefWidth="130"/>
        <ComboBox fx:id="departmentFilter" promptText="All Departments" styleClass="combo-box" prefWidth="170"/>
        <ComboBox fx:id="statusFilter" promptText="All Statuses" styleClass="combo-box" prefWidth="140"/>
        <Button text="Filter" styleClass="primary-btn" onAction="#applyFilters"/>
        <Button text="Clear" styleClass="secondary-btn" onAction="#clearFilters"/>
    </HBox>

    <!-- Users Table -->
    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colId"         text="ID"         prefWidth="55"  minWidth="40"/>
            <TableColumn fx:id="colName"       text="Name"       prefWidth="160" minWidth="100"/>
            <TableColumn fx:id="colEmail"      text="Email"      prefWidth="210" minWidth="140"/>
            <TableColumn fx:id="colDepartment" text="Department" prefWidth="150" minWidth="100"/>
            <TableColumn fx:id="colSemester"   text="Sem"        prefWidth="55"  minWidth="40"/>
            <TableColumn fx:id="colRole"       text="Role"       prefWidth="90"  minWidth="70"/>
            <TableColumn fx:id="colStatus"     text="Status"     prefWidth="90"  minWidth="70"/>
            <TableColumn fx:id="colPoints"     text="Pts"        prefWidth="55"  minWidth="40"/>
            <TableColumn fx:id="colCreatedAt"  text="Joined"     prefWidth="100" minWidth="80"/>
        </columns>
        <placeholder><Label text="No users found." style="-fx-text-fill:#94a3b8;"/></placeholder>
    </TableView>

    <!-- Pagination -->
    <HBox alignment="CENTER" spacing="14">
        <Button fx:id="btnPrevPage" text="◀ Prev" styleClass="secondary-btn" onAction="#handlePrevPage"/>
        <Label fx:id="lblPageNumber" text="Page 1 of 1"
               style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:#374151;"/>
        <Button fx:id="btnNextPage" text="Next ▶" styleClass="secondary-btn" onAction="#handleNextPage"/>
    </HBox>

    <!-- Action Buttons -->
    <VBox styleClass="panel-card" spacing="12">
        <Label text="Selected User Actions" styleClass="panel-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT" wrap="true">
            <Button text="✏️ Edit"           styleClass="primary-btn"  onAction="#handleEdit"/>
            <Button text="🔑 Reset Password" styleClass="warning-btn"  onAction="#handleResetPassword"/>
            <Button text="⏸ Suspend"         styleClass="warning-btn"  onAction="#handleSuspend"/>
            <Button text="▶ Activate"        styleClass="success-btn"  onAction="#handleActivate"/>
            <Button text="🚫 Ban"            styleClass="danger-btn"   onAction="#handleBan"/>
            <Button text="⬆ Promote Admin"  styleClass="primary-btn"  style="-fx-background-color: #7c3aed;" onAction="#handlePromote"/>
            <Button text="⬇ Demote User"    styleClass="secondary-btn" onAction="#handleDemote"/>
            <Button text="🗑 Delete"          styleClass="danger-btn"   onAction="#handleDelete"/>
        </HBox>
    </VBox>

</VBox>
