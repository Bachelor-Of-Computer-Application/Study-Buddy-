<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="content-scroll" stylesheets="@../../css/theme.css, @../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminGlobalSearchController">
    <content>
        <VBox spacing="16" styleClass="content-wrap">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Global Search" styleClass="section-title"/>
                    <Label fx:id="resultSummaryLabel" text="Search across users, notes, resources, and questions."
                           styleClass="section-subtitle"/>
                </VBox>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
                <TextField fx:id="searchField" promptText="Search all modules…"
                           styleClass="search-field" prefWidth="320" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                           onAction="#handleSearch"/>
                <Button text="Search" styleClass="primary-btn" onAction="#handleSearch"/>
            </HBox>

            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <tabs>
                    <Tab text="Users">
                        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colUserName" text="Username" prefWidth="140"/>
                                <TableColumn fx:id="colUserEmail" text="Email" prefWidth="220"/>
                                <TableColumn fx:id="colUserRole" text="Role" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="No matching users." styleClass="table-empty-label"/>
                            </placeholder>
                        </TableView>
                    </Tab>
                    <Tab text="Notes">
                        <TableView fx:id="notesTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colNoteTitle" text="Title" prefWidth="220"/>
                                <TableColumn fx:id="colNoteSubject" text="Subject" prefWidth="160"/>
                                <TableColumn fx:id="colNoteStatus" text="Status" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="No matching notes." styleClass="table-empty-label"/>
                            </placeholder>
                        </TableView>
                    </Tab>
                    <Tab text="Resources">
                        <TableView fx:id="resourcesTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colResTitle" text="Title" prefWidth="220"/>
                                <TableColumn fx:id="colResSubject" text="Subject" prefWidth="160"/>
                                <TableColumn fx:id="colResStatus" text="Status" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="No matching resources." styleClass="table-empty-label"/>
                            </placeholder>
                        </TableView>
                    </Tab>
                    <Tab text="Questions">
                        <TableView fx:id="questionsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colQuestionTitle" text="Title" prefWidth="220"/>
                                <TableColumn fx:id="colQuestionSubject" text="Subject" prefWidth="160"/>
                                <TableColumn fx:id="colQuestionAuthor" text="Author" prefWidth="140"/>
                            </columns>
                            <placeholder>
                                <Label text="No matching questions." styleClass="table-empty-label"/>
                            </placeholder>
                        </TableView>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </content>
</ScrollPane>
