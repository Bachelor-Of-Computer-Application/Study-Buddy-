<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<!-- Split-panel login: left branding + right form -->
<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studybuddy.admin.controllers.AdminLoginController"
      stylesheets="@../css/admin-dashboard.css">

    <!-- LEFT – Branding Panel -->
    <VBox styleClass="login-left-panel" alignment="CENTER" spacing="20" HBox.hgrow="SOMETIMES">
        <padding><Insets top="60" right="50" bottom="60" left="50"/></padding>

        <Label text="📚" style="-fx-font-size: 56px;"/>

        <VBox spacing="8" alignment="CENTER">
            <Label text="StudyBuddy" styleClass="branding-title"/>
            <Label text="Administration Portal" styleClass="branding-tagline"/>
        </VBox>

        <Separator style="-fx-background-color: rgba(255,255,255,0.2);" maxWidth="200"/>

        <VBox spacing="12" alignment="CENTER_LEFT">
            <Label text="✅  Manage Users &amp; Content" styleClass="branding-feature"/>
            <Label text="✅  Moderate Notes &amp; Resources" styleClass="branding-feature"/>
            <Label text="✅  Monitor Activity &amp; Reports" styleClass="branding-feature"/>
            <Label text="✅  Configure System Settings" styleClass="branding-feature"/>
        </VBox>
    </VBox>

    <!-- RIGHT – Login Form -->
    <VBox styleClass="login-card" alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS">
        <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>

        <VBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Welcome back" styleClass="login-title"/>
            <Label text="Sign in to your admin account" styleClass="login-subtitle"/>
        </VBox>

        <VBox spacing="20" VBox.vgrow="ALWAYS">
            <VBox.margin><Insets top="36"/></VBox.margin>

            <VBox spacing="6">
                <Label text="Email / Username" styleClass="input-label"/>
                <TextField fx:id="usernameField"
                           promptText="admin@studybuddy.com"
                           styleClass="input-field"
                           maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="input-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="input-field"
                               maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="errorLabel"
                   styleClass="error-label"
                   visible="false"
                   managed="false"
                   maxWidth="Infinity"
                   wrapText="true"/>
        </VBox>

        <Button fx:id="loginButton"
                text="Sign In →"
                styleClass="login-button"
                maxWidth="Infinity"
                onAction="#handleLogin">
            <VBox.margin><Insets top="32"/></VBox.margin>
        </Button>

        <Label text="StudyBuddy Admin v1.0  •  Authorized Access Only"
               style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-alignment: CENTER;">
            <VBox.margin><Insets top="24"/></VBox.margin>
        </Label>
    </VBox>

</HBox>
