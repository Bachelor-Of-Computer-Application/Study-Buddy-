<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" stylesheets="@../css/admin-dashboard.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studybuddy.admin.controllers.AdminNotificationsController"
      styleClass="admin-panel-bg">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Notifications" styleClass="section-title"/>
            <Label fx:id="lblUnreadCount" text="Unread: 0" styleClass="section-subtitle"/>
        </VBox>
        <Button text="↻ Refresh" styleClass="secondary-btn" onAction="#handleRefresh"/>
    </HBox>

    <GridPane hgap="16" vgap="14">
        <columnConstraints>
            <ColumnConstraints percentWidth="42"/>
            <ColumnConstraints percentWidth="58"/>
        </columnConstraints>

        <!-- ── Send Notification Form ── -->
        <VBox styleClass="panel-card" spacing="14" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Send New Notification" styleClass="panel-title"/>
            <Label text="Broadcast to users, departments, semesters, or individuals"
                   styleClass="panel-subtitle" wrapText="true"/>

            <GridPane hgap="12" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Title" styleClass="input-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="titleField" promptText="Notification title…"
                           styleClass="input-field" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Message" styleClass="input-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextArea fx:id="messageArea" promptText="Write your message here…"
                          styleClass="text-area" prefHeight="100" wrapText="true"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Send To" styleClass="input-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="recipientTypeCombo" styleClass="combo-box" maxWidth="Infinity"
                          onAction="#onRecipientTypeChanged"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label fx:id="recipientValueLabel" text="Recipient:"
                       styleClass="input-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="recipientValueField" promptText="e.g. Computer Science / 3 / john@email.com"
                           styleClass="input-field" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Priority" styleClass="input-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="priorityCombo" styleClass="combo-box" maxWidth="Infinity"
                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="📤 Send Notification" styleClass="primary-btn" onAction="#handleSend"/>
                <Button text="✖ Clear"              styleClass="secondary-btn" onAction="#handleClearForm"/>
            </HBox>
        </VBox>

        <!-- ── Notification History ── -->
        <VBox styleClass="panel-card" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Notification History" styleClass="panel-title"/>
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" prefHeight="420" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colTitle"     text="Title"      prefWidth="160" minWidth="100"/>
                    <TableColumn fx:id="colRecipient" text="Recipient"  prefWidth="160" minWidth="100"/>
                    <TableColumn fx:id="colPriority"  text="Priority"   prefWidth="90"  minWidth="60"/>
                    <TableColumn fx:id="colSentAt"    text="Sent At"    prefWidth="140" minWidth="100"/>
                    <TableColumn fx:id="colRead"      text="Status"     prefWidth="90"  minWidth="70"/>
                </columns>
                <placeholder><Label text="No notifications sent yet." style="-fx-text-fill:#94a3b8;"/></placeholder>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="✅ Mark as Read" styleClass="secondary-btn" onAction="#handleMarkRead"/>
                <Button text="🗑 Delete"        styleClass="danger-btn"   onAction="#handleDelete"/>
            </HBox>
        </VBox>
    </GridPane>

</VBox>
