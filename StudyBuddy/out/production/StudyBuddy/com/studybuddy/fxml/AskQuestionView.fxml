<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="root-pane"
    stylesheets="@../css/theme.css, @../css/ask-question.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.studybuddy.controllers.AskQuestionController">

    <!-- ══ TOP – Minimal breadcrumb bar (preserves logoImage/homeButton/profileButton) -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">

            <!-- Logo (kept for controller @FXML binding) -->
            <ImageView fx:id="logoImage" fitWidth="28" fitHeight="28"
                       preserveRatio="true" styleClass="logo-image"/>

            <Label text="Ask a Question" styleClass="breadcrumb-title"
                   HBox.hgrow="ALWAYS"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Home / Profile buttons kept for controller binding -->
            <VBox alignment="CENTER" spacing="2" styleClass="nav-item">
                <Button fx:id="homeButton" onAction="#handleHome"
                        styleClass="icon-button" text="⌂"/>
                <Label text="HOME" styleClass="nav-text"/>
            </VBox>
            <VBox alignment="CENTER" spacing="2" styleClass="nav-item">
                <Button fx:id="profileButton" onAction="#handleProfile"
                        styleClass="icon-button" text="👤"/>
                <Label text="PROFILE" styleClass="nav-text"/>
            </VBox>
        </HBox>
    </top>

    <!-- ══ CENTER – Main scrollable form content ══════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane-clean"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20"
                      styleClass="content-container">
                    <padding><Insets top="28" right="60" bottom="36" left="60"/></padding>

                    <!-- Page heading -->
                    <VBox spacing="6" maxWidth="760">
                        <Label fx:id="pageTitle" styleClass="page-title"
                               text="Ask a question about your assignment"/>
                        <Label text="Be specific and clear to get the best answers from your peers."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <!-- ── Question editor card ─────────────────────── -->
                    <VBox styleClass="editor-card" spacing="10" maxWidth="760">
                        <Label text="Write your question" styleClass="editor-heading"/>
                        <Label text="Keep it simple and clear to get the best answer"
                               styleClass="editor-subheading"/>
                        <TextArea fx:id="questionTextArea"
                                  wrapText="true"
                                  prefHeight="180"
                                  promptText="Describe your question in detail…"
                                  styleClass="question-text-area"/>
                    </VBox>

                    <!-- ── Attachment toolbar ───────────────────────── -->
                    <HBox styleClass="toolbar" spacing="10" alignment="CENTER_LEFT" maxWidth="760">
                        <Button fx:id="attachmentButton" onAction="#handleAttachment"
                                styleClass="toolbar-button"
                                text="📎 Attach Subject Material"/>
                        <Button fx:id="toolsButton" onAction="#handleMath"
                                styleClass="toolbar-button"
                                text="🛠 Apply Special Tools"/>
                        <Button fx:id="filesButton" onAction="#handleSymbols"
                                styleClass="toolbar-button"
                                text="📁 Attach Relevant Files"/>
                    </HBox>

                    <!-- ── Bottom controls card ────────────────────── -->
                    <HBox styleClass="bottom-controls" spacing="20"
                          alignment="CENTER_LEFT" maxWidth="760">

                        <!-- Subject selector -->
                        <VBox spacing="6" styleClass="subject-group" HBox.hgrow="ALWAYS">
                            <Label text="Subject" styleClass="control-label"/>
                            <ComboBox fx:id="subjectComboBox" prefWidth="340"
                                      promptText="Pick a subject"
                                      styleClass="rounded-combo-box"/>
                        </VBox>

                        <!-- Reward points selector -->
                        <VBox spacing="6" styleClass="points-group">
                            <Label text="Reward Points" styleClass="control-label"/>
                            <ComboBox fx:id="rewardPointsComboBox" prefWidth="140"
                                      promptText="0"
                                      styleClass="rounded-combo-box"/>
                        </VBox>

                        <!-- Points display -->
                        <VBox spacing="6" styleClass="points-display-group">
                            <Label text="Your Points" styleClass="control-label"/>
                            <HBox alignment="CENTER_LEFT" spacing="6"
                                  styleClass="points-display">
                                <Label text="115" styleClass="points-value"/>
                                <Label text="pts" styleClass="points-unit"/>
                                <Label text="i" styleClass="points-info"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- ── Submit button ────────────────────────────── -->
                    <HBox alignment="CENTER">
                        <Button fx:id="submitButton"
                                text="ASK YOUR QUESTION  →"
                                onAction="#handleSubmit"
                                styleClass="submit-button"/>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>