<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="root-pane"
    stylesheets="@../css/theme.css, @../css/resources.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.studybuddy.controllers.ResourcesController">

    <center>
        <VBox spacing="0">
            <!-- ── Page Header + Filter Area ─────────────────────────── -->
            <VBox spacing="16">
                <padding><Insets top="24" right="24" bottom="0" left="24"/></padding>

                <!-- Header card -->
                <HBox alignment="CENTER_LEFT" spacing="20"
                      styleClass="page-header-card">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="📂  Resource Library" styleClass="page-title"/>
                        <Label styleClass="page-subtitle"
                               text="Find and download academic guides, textbooks, and PDF lecture slides."/>
                    </VBox>
                    <Button onAction="#handleUploadResource" styleClass="upload-btn"
                            text="📤  Upload PDF Resource"/>
                </HBox>

                <!-- Filter bar -->
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-bar">
                    <TextField fx:id="searchField" promptText="🔍  Search resources by title…"
                               prefWidth="240" styleClass="search-field"/>
                    <ComboBox fx:id="subjectFilter" promptText="Filter by Subject"
                              prefWidth="175" styleClass="combo-box"/>
                    <Button onAction="#applyFilters" text="Search"
                            styleClass="save-button"/>
                    <Button onAction="#clearFilters" text="Reset"
                            styleClass="cancel-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- ── Tab Pane ──────────────────────────────────────────── -->
            <VBox VBox.vgrow="ALWAYS">
                <padding><Insets top="16" right="24" bottom="24" left="24"/></padding>
                <TabPane fx:id="resourcesTabPane" tabClosingPolicy="UNAVAILABLE"
                         styleClass="tab-pane" VBox.vgrow="ALWAYS">

                    <!-- Community Library tab -->
                    <Tab text="📚  Community Library">
                        <ScrollPane fitToWidth="true" styleClass="scroll-pane"
                                    vbarPolicy="AS_NEEDED">
                            <content>
                                <VBox spacing="16">
                                    <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                                    <FlowPane fx:id="resourcesFlowPane" hgap="16" vgap="16"
                                              styleClass="notes-grid"/>
                                    <!-- Empty state -->
                                    <VBox fx:id="emptyState" alignment="CENTER" spacing="12"
                                          styleClass="empty-state" visible="false"
                                          managed="false">
                                        <Label text="📂" style="-fx-font-size:48px;"/>
                                        <Label text="No approved resources found."
                                               style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#475569;"/>
                                        <Label text="Be the first to upload one!"
                                               style="-fx-font-size:12px;-fx-text-fill:#94a3b8;"/>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </Tab>

                    <!-- My Upload History tab -->
                    <Tab text="🕒  My Upload History">
                        <VBox spacing="0" styleClass="tab-content" VBox.vgrow="ALWAYS">
                            <padding><Insets top="4" right="0" bottom="0" left="0"/></padding>
                            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="titleCol"    text="Title"         prefWidth="220"/>
                                    <TableColumn fx:id="subjectCol"  text="Subject"        prefWidth="140"/>
                                    <TableColumn fx:id="fileNameCol" text="File Name"      prefWidth="180"/>
                                    <TableColumn fx:id="dateCol"     text="Uploaded Date"  prefWidth="140"/>
                                    <TableColumn fx:id="statusCol"   text="Status"         prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                </TabPane>
            </VBox>
        </VBox>
    </center>

</BorderPane>
