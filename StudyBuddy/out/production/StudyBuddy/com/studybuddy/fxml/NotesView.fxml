<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainBorderPane" styleClass="root-pane"
    stylesheets="@../css/theme.css, @../css/notes.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.studybuddy.controllers.NotesController">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="scroll-pane" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="18">
                    <padding><Insets top="24" right="24" bottom="28" left="24"/></padding>

                    <!-- ── Page Header Card ──────────────────────────── -->
                    <HBox alignment="CENTER_LEFT" spacing="20"
                          styleClass="page-header-card">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="📝  My Notes" styleClass="page-title"/>
                            <Label styleClass="page-subtitle"
                                   text="Create personal notebooks, study guides, and share with the community."/>
                        </VBox>
                        <Button onAction="#showCreateNoteDialog"
                                styleClass="create-note-btn"
                                text="＋  Create Note"/>
                    </HBox>

                    <!-- ── Filter Bar ────────────────────────────────── -->
                    <VBox spacing="12" styleClass="filter-bar">
                        <Label text="FILTER LIBRARY" styleClass="filter-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="5">
                                <Label text="Subject" styleClass="filter-label"/>
                                <ComboBox fx:id="subjectFilter" prefWidth="220"
                                          promptText="All Subjects" styleClass="field-box"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Source" styleClass="filter-label"/>
                                <ComboBox fx:id="sourceFilter" prefWidth="220"
                                          promptText="All Sources" styleClass="field-box"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <VBox alignment="BOTTOM_LEFT" spacing="5">
                                <Label text=" " styleClass="filter-label"/>
                                <HBox spacing="8">
                                    <Button onAction="#applyFilters"
                                            styleClass="apply-button" text="Apply Filter"/>
                                    <Button onAction="#clearFilters"
                                            styleClass="clear-button" text="Clear"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ── Tab Pane ──────────────────────────────────── -->
                    <TabPane fx:id="notesTabPane" styleClass="notes-tabs"
                             tabClosingPolicy="UNAVAILABLE">

                        <Tab text="🔒  Personal Notes">
                            <VBox spacing="0" styleClass="tab-content">
                                <VBox fx:id="myNotesContainer" spacing="10"
                                      styleClass="notes-list"/>
                            </VBox>
                        </Tab>

                        <Tab text="👥  Community Notes Status">
                            <VBox spacing="0" styleClass="tab-content">
                                <VBox fx:id="communityNotesContainer" spacing="10"
                                      styleClass="notes-list"/>
                            </VBox>
                        </Tab>
                    </TabPane>

                    <!-- ── Empty State (shown/hidden by controller) ─── -->
                    <VBox fx:id="emptyState" alignment="CENTER" managed="false"
                          spacing="12" styleClass="empty-state" visible="false">
                        <Label styleClass="empty-icon" text="📖"/>
                        <Label styleClass="empty-text" text="No notes found."/>
                        <Label style="-fx-font-size:12px;-fx-text-fill:#94a3b8;"
                               text="Create your first note using the button above."/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
