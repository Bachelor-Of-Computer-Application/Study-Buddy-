<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainBorderPane" styleClass="root-pane" stylesheets="@../css/notes.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.studybuddy.controllers.NotesController">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fillWidth="true" prefWidth="526.0" spacing="18" styleClass="page-wrap">

                    <VBox prefHeight="238.0" prefWidth="406.0" spacing="0" styleClass="screen-shell">
                        <VBox spacing="0" styleClass="hero-area">
                            <HBox alignment="TOP_LEFT" spacing="20" styleClass="hero-top-row">
                                <VBox spacing="10" VBox.vgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT" spacing="14">
                                        <Label styleClass="brand-title" text="Study Buddy" />
                                        <Label styleClass="brand-icon" text="📘" />
                                        <Label styleClass="brand-title" text="Library" />
                                    </HBox>
                                    <Label styleClass="brand-subtitle" text="Create personal notebooks, study guides, and review materials, or share them with the community." wrapText="true" />
                                </VBox>

                                <VBox alignment="CENTER" spacing="12" styleClass="hero-badge">
                                    <Label styleClass="top-action-icon" text="👤" />
                                    <Label styleClass="top-action-text" text="Profile" />
                                    <Label styleClass="top-action-icon" text="🏠" />
                                    <Label styleClass="top-action-text" text="Home" />
                                </VBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <VBox alignment="CENTER" styleClass="book-circle">
                                    <Label styleClass="book-circle-icon" text="📖" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="0" styleClass="card action-card">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Button onAction="#showCreateNoteDialog" styleClass="icon-plus-button" text="+" />
                                <Label styleClass="action-card-title" text="CREATE PERSONAL NOTE" />
                            </HBox>
                        </VBox>

                        <VBox spacing="12" styleClass="card filter-card">
                            <Label styleClass="section-title" text="Filter Library" />
                            <HBox alignment="CENTER_LEFT" spacing="18">
                                <VBox spacing="6">
                                    <Label styleClass="field-label" text="Subject" />
                                    <ComboBox fx:id="subjectFilter" prefWidth="260" promptText="Mathematics" styleClass="field-box" />
                                </VBox>
                                <VBox spacing="6">
                                    <Label styleClass="field-label" text="Source" />
                                    <ComboBox fx:id="sourceFilter" prefWidth="260" promptText="University Database" styleClass="field-box" />
                                </VBox>
                                <Button onAction="#applyFilters" styleClass="apply-button" text="Apply Filter" />
                                <Button onAction="#clearFilters" styleClass="clear-button" text="Clear" />
                            </HBox>
                        </VBox>

                        <TabPane fx:id="notesTabPane" styleClass="notes-tabs" tabClosingPolicy="UNAVAILABLE">
                            <Tab text="🔒 Personal Notes">
                                <VBox spacing="0" styleClass="tab-content">
                                    <VBox fx:id="myNotesContainer" spacing="8" styleClass="notes-list" />
                                </VBox>
                            </Tab>
                            <Tab text="👥 Community Notes Status">
                                <VBox spacing="0" styleClass="tab-content">
                                    <VBox fx:id="communityNotesContainer" spacing="8" styleClass="notes-list" />
                                </VBox>
                            </Tab>
                        </TabPane>

                        <VBox fx:id="emptyState" alignment="CENTER" managed="false" spacing="12" styleClass="empty-state" visible="false">
                            <Label styleClass="empty-icon" text="📖" />
                            <Label styleClass="empty-text" text="No notes found in this folder." />
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
