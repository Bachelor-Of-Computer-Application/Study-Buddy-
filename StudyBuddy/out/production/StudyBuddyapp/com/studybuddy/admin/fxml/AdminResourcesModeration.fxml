<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" stylesheets="@../css/admin-dashboard.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studybuddy.admin.controllers.AdminResourcesController"
      style="-fx-background-color: #f1f5f9;">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Resource Management" styleClass="section-title"/>
            <Label fx:id="lblTotalCount" text="Loading…" styleClass="section-subtitle"/>
        </VBox>
        <Button text="↻ Refresh" styleClass="secondary-btn" onAction="#handleRefresh"/>
    </HBox>

    <!-- Filter Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
        <TextField fx:id="searchField" promptText="🔍  Search title, subject, uploader…"
                   styleClass="search-field" prefWidth="260"/>
        <ComboBox fx:id="subjectFilter" promptText="Subject" styleClass="combo-box" prefWidth="160"/>
        <ComboBox fx:id="statusFilter"  promptText="Status"  styleClass="combo-box" prefWidth="130"/>
        <Button text="Filter" styleClass="primary-btn" onAction="#applyFilters"/>
        <Button text="Clear"  styleClass="secondary-btn" onAction="#clearFilters"/>
    </HBox>

    <!-- Resources Table (sortable by Downloads) -->
    <TableView fx:id="resourcesTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colId"        text="ID"          prefWidth="55"  minWidth="40"/>
            <TableColumn fx:id="colTitle"     text="Title"       prefWidth="220" minWidth="120"/>
            <TableColumn fx:id="colSubject"   text="Subject"     prefWidth="140" minWidth="80"/>
            <TableColumn fx:id="colUploader"  text="Uploaded By" prefWidth="140" minWidth="80"/>
            <TableColumn fx:id="colDownloads" text="⬇ Downloads" prefWidth="100" minWidth="70" sortable="true"/>
            <TableColumn fx:id="colStatus"    text="Status"      prefWidth="110" minWidth="70"/>
            <TableColumn fx:id="colDate"      text="Upload Date" prefWidth="160" minWidth="100"/>
        </columns>
        <placeholder><Label text="No resources found." style="-fx-text-fill:#94a3b8;"/></placeholder>
    </TableView>

    <!-- Pagination -->
    <HBox alignment="CENTER" spacing="14">
        <Button fx:id="btnPrevPage" text="◀ Prev" styleClass="secondary-btn" onAction="#handlePrevPage"/>
        <Label fx:id="lblPageNumber" text="Page 1 of 1"
               style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:#374151;"/>
        <Button fx:id="btnNextPage" text="Next ▶" styleClass="secondary-btn" onAction="#handleNextPage"/>
    </HBox>

    <!-- Actions -->
    <VBox styleClass="panel-card" spacing="12">
        <Label text="Selected Resource Actions" styleClass="panel-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="👁 Preview"      styleClass="secondary-btn" onAction="#handlePreview"/>
            <Button text="⬇ Download"     styleClass="primary-btn"   onAction="#handleDownload"/>
            <Button text="✅ Activate"     styleClass="success-btn"   onAction="#handleActivate"/>
            <Button text="⏸ Deactivate"   styleClass="warning-btn"   onAction="#handleDeactivate"/>
            <Button text="🗑 Delete"        styleClass="danger-btn"    onAction="#handleDelete"/>
        </HBox>
    </VBox>

</VBox>
