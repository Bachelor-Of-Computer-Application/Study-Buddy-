<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" stylesheets="@../css/admin-dashboard.css" styleClass="content-wrap"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.studybuddy.admin.controllers.AdminUsersController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header -->
    <Label text="User Accounts Moderation" styleClass="page-title" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

    <!-- Filter Bar -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-section" style="-fx-padding: 10; -fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1px;">
        <TextField fx:id="searchField" promptText="Search by name or email..." prefWidth="250.0" styleClass="search-field"/>
        <ComboBox fx:id="roleFilter" promptText="All Roles" prefWidth="130.0"/>
        <ComboBox fx:id="statusFilter" promptText="All Statuses" prefWidth="130.0"/>
        <Button text="🔍 Filter" styleClass="primary-btn" onAction="#applyFilters"/>
        <Button text="Reset" styleClass="cancel-btn" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569;" onAction="#clearFilters"/>
    </HBox>

    <!-- Users Table -->
    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" prefHeight="400">
        <columns>
            <TableColumn fx:id="userIdCol" text="ID" prefWidth="60"/>
            <TableColumn fx:id="usernameCol" text="Name" prefWidth="180"/>
            <TableColumn fx:id="emailCol" text="Email" prefWidth="240"/>
            <TableColumn fx:id="userRoleCol" text="Role" prefWidth="120"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="120"/>
        </columns>
    </TableView>

    <!-- Pagination Row -->
    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="btnPrevPage" text="◀ Prev" styleClass="primary-btn" style="-fx-background-color: #e2e8f0; -fx-text-fill: #1e293b;" onAction="#handlePrevPage"/>
        <Label fx:id="lblPageNumber" text="Page 1 of 1" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
        <Button fx:id="btnNextPage" text="Next ▶" styleClass="primary-btn" style="-fx-background-color: #e2e8f0; -fx-text-fill: #1e293b;" onAction="#handleNextPage"/>
    </HBox>

    <!-- Actions Row -->
    <HBox spacing="12">
        <Button text="Toggle Suspend" styleClass="primary-btn" onAction="#handleToggleUserStatus"/>
        <Button text="Ban Account" styleClass="danger-btn" onAction="#handleBanUser"/>
        <Button text="Edit Info" styleClass="primary-btn" style="-fx-background-color: #4f46e5;" onAction="#handleEditUserInfo"/>
        <Button text="Delete Account" styleClass="danger-btn" style="-fx-background-color: #991b1b;" onAction="#handleDeleteUser"/>
    </HBox>
</VBox>
