<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="main-scroll" stylesheets="@../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminReportsController">
    <content>
        <VBox spacing="20" styleClass="content-wrap">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Header -->
            <Label text="System Reports &amp; Growth Analytics" styleClass="page-title" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

            <!-- Charts Grid -->
            <GridPane hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="280"/>
                    <RowConstraints minHeight="280"/>
                    <RowConstraints minHeight="280"/>
                </rowConstraints>

                <!-- Chart 1: User Growth -->
                <VBox styleClass="panel-card" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="User Growth (Monthly)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <LineChart fx:id="userGrowthChart" legendVisible="false" prefHeight="240">
                        <xAxis><CategoryAxis label="Months"/></xAxis>
                        <yAxis><NumberAxis label="Registered Users"/></yAxis>
                    </LineChart>
                </VBox>

                <!-- Chart 2: Notes Uploaded -->
                <VBox styleClass="panel-card" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Notes Uploaded (Weekly)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <BarChart fx:id="notesUploadedChart" legendVisible="false" prefHeight="240">
                        <xAxis><CategoryAxis label="Weeks"/></xAxis>
                        <yAxis><NumberAxis label="Notes Count"/></yAxis>
                    </BarChart>
                </VBox>

                <!-- Chart 3: Questions Asked -->
                <VBox styleClass="panel-card" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Questions Asked (Daily)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <BarChart fx:id="questionsAskedChart" legendVisible="false" prefHeight="240">
                        <xAxis><CategoryAxis label="Days"/></xAxis>
                        <yAxis><NumberAxis label="Questions Asked"/></yAxis>
                    </BarChart>
                </VBox>

                <!-- Chart 4: Resources Shared -->
                <VBox styleClass="panel-card" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Shared PDFs &amp; Resources (Weekly)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <BarChart fx:id="resourcesSharedChart" legendVisible="false" prefHeight="240">
                        <xAxis><CategoryAxis label="Weeks"/></xAxis>
                        <yAxis><NumberAxis label="Resources shared"/></yAxis>
                    </BarChart>
                </VBox>

                <!-- Chart 5: Monthly statistics PieChart -->
                <VBox styleClass="panel-card" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                    <Label text="Monthly Resource Downloads vs Uploads vs Q&amp;A" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <HBox alignment="CENTER">
                        <PieChart fx:id="monthlyStatsChart" prefHeight="260" prefWidth="500"/>
                    </HBox>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
