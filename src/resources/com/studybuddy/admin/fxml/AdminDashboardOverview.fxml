<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="main-scroll" stylesheets="@../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminOverviewController">
    <content>
        <VBox spacing="20" styleClass="content-wrap">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Page Header -->
            <Label text="System Overview" styleClass="page-title" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

            <!-- Admin Stats Cards Row -->
            <HBox spacing="12" styleClass="stats-row">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Pending Notes" styleClass="stat-title"/>
                    <Label fx:id="lblPendingNotes" text="1" styleClass="stat-value" style="-fx-text-fill: #f59e0b;"/>
                    <Label text="Requires review" styleClass="stat-growth"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Pending Resources" styleClass="stat-title"/>
                    <Label fx:id="lblPendingResources" text="2" styleClass="stat-value" style="-fx-text-fill: #f59e0b;"/>
                    <Label text="Requires review" styleClass="stat-growth"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Pending Questions" styleClass="stat-title"/>
                    <Label fx:id="lblPendingQuestions" text="0" styleClass="stat-value" style="-fx-text-fill: #10b981;"/>
                    <Label text="Requires review" styleClass="stat-growth"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Total Users" styleClass="stat-title"/>
                    <Label fx:id="lblTotalUsers" text="4" styleClass="stat-value"/>
                    <Label text="Registered accounts" styleClass="stat-growth"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Today's Activities" styleClass="stat-title"/>
                    <Label text="18" styleClass="stat-value" style="-fx-text-fill: #3b82f6;"/>
                    <Label text="System interactions" styleClass="stat-growth"/>
                </VBox>
            </HBox>

            <!-- Charts & System Logs Row -->
            <GridPane hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints percentWidth="60"/>
                    <ColumnConstraints percentWidth="40"/>
                </columnConstraints>

                <!-- Pie Chart & Progress metrics -->
                <VBox styleClass="panel-card" spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Resource Library Distribution" styleClass="panel-title"/>
                    <HBox alignment="CENTER" spacing="20">
                        <PieChart fx:id="resourcePieChart" prefHeight="240" prefWidth="300"/>
                        <VBox spacing="15" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                            <Label text="Approval Performance:" style="-fx-font-weight: bold;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Approved:" prefWidth="80"/>
                                <ProgressBar fx:id="approvedBar" progress="0.75" prefWidth="150" styleClass="success-bar"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Pending:" prefWidth="80"/>
                                <ProgressBar fx:id="pendingBar" progress="0.15" prefWidth="150" styleClass="warning-bar"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Rejected:" prefWidth="80"/>
                                <ProgressBar fx:id="rejectedBar" progress="0.10" prefWidth="150" styleClass="danger-bar"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Activity Feed -->
                <VBox styleClass="panel-card" spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Recent Actions Log" styleClass="panel-title"/>
                    <ListView fx:id="moderationLogsList" prefHeight="240" VBox.vgrow="ALWAYS" />
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
