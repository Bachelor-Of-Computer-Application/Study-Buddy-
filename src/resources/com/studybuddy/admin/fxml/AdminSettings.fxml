<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="main-scroll" stylesheets="@../css/admin-dashboard.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studybuddy.admin.controllers.AdminSettingsController">
    <content>
        <VBox spacing="20" styleClass="content-wrap">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Header -->
            <Label text="Administrative Portal Settings" styleClass="page-title" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

            <!-- Panel 1: Theme & Configurations -->
            <VBox styleClass="panel-card" spacing="15">
                <Label text="General Preferences" styleClass="panel-title" style="-fx-font-size: 15px;"/>
                <VBox spacing="10">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="Display Theme:" prefWidth="120"/>
                        <ComboBox fx:id="themeComboBox" prefWidth="150"/>
                    </HBox>
                    <CheckBox fx:id="systemMailsCheck" text="Send daily moderator summaries via email" selected="true"/>
                    <CheckBox fx:id="realTimeAlertsCheck" text="Enable real-time admin desktop alerts for new reviews" selected="true"/>
                </VBox>
                <Button text="Save General Settings" styleClass="primary-btn" onAction="#saveGeneralSettings"/>
            </VBox>

            <!-- Panel 2: Profile Settings -->
            <VBox styleClass="panel-card" spacing="15">
                <Label text="Admin Profile Details" styleClass="panel-title" style="-fx-font-size: 15px;"/>
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="120"/>
                        <ColumnConstraints HBox.hgrow="ALWAYS"/>
                    </columnConstraints>
                    
                    <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="adminNameField" text="Super Admin" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    
                    <Label text="Email Address:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="adminEmailField" text="admin@studybuddy.com" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>
                <Button text="Save Profile Info" styleClass="primary-btn" style="-fx-background-color: #4f46e5;" onAction="#saveProfileInfo"/>
            </VBox>

            <!-- Panel 3: Change Password -->
            <VBox styleClass="panel-card" spacing="15">
                <Label text="Security &amp; Password" styleClass="panel-title" style="-fx-font-size: 15px;"/>
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="150"/>
                        <ColumnConstraints HBox.hgrow="ALWAYS"/>
                    </columnConstraints>
                    
                    <Label text="Current Password:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="currentPasswordField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    
                    <Label text="New Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="newPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    
                    <Label text="Confirm Password:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="confirmPasswordField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
                <Button text="Change Password" styleClass="danger-btn" onAction="#changePassword"/>
            </VBox>

            <!-- Panel 4: Application Info -->
            <VBox styleClass="panel-card" spacing="10">
                <Label text="Application System Information" styleClass="panel-title" style="-fx-font-size: 15px;"/>
                <Label text="Version: 1.0.0 Stable" style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                <Label text="Environment: JavaFX 26.0.1 Runtime" style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                <Label text="Database Sync Status: Connected (MSSQL Local)" style="-fx-text-fill: #16a34a; -fx-font-size: 13px;"/>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
